rules_version = '2';

// ============================================================
//  Hành Thực Lục - Quy tắc bảo mật Firestore (7 cấp phân quyền)
//  - Admin Tổng / HT (SUPER_ADMIN - Cấp 7): Toàn quyền cấu hình, phân quyền tất cả các cấp.
//  - Ban Quản Trị HT (ADMIN - Cấp 6): Quản trị hệ thống, đổi/đặt lại PIN, duyệt ĐK & phân quyền cấp 5 trở xuống.
//  - QL Cụm (MANAGER - Cấp 5): Tổ chức & Nhân sự trong cụm, phân quyền cấp 4 trở xuống.
//  - TS, NQ (SION_LEADER - Cấp 4): Tổ chức & Nhân sự trong Sion, phân quyền cấp 3 trở xuống.
//  - Gru (AREA_LEADER - Cấp 3): Tổ chức & Nhân sự trong khu vực, phân quyền cấp 2 trở xuống.
//  - Uni (UNI_LEADER - Cấp 2): Tổ chức & Nhân sự trong đội Uni, phân quyền cấp 1 trở xuống.
//  - TĐ (MEMBER - Cấp 1): Tự quản lý hồ sơ MĐ của chính mình, nhập báo cáo hằng ngày.
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // Mặc định: chặn tất cả truy cập chưa định nghĩa
    match /{document=**} {
      allow read, write: if false;
    }

    // ---------- Các hàm trợ giúp bảo mật ----------
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_-]+$');
    }

    function userDocPath() {
      return /databases/$(database)/documents/users/$(request.auth != null ? request.auth.uid : '_none_');
    }

    function configRolesPath() {
      return /databases/$(database)/documents/system_config/roles;
    }

    function hasVerifiedEmail() {
      return request.auth != null
        && 'email' in request.auth.token
        && 'email_verified' in request.auth.token
        && request.auth.token.email != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.size() > 0;
    }

    function hasOwnRoleClaim() {
      let verified = hasVerifiedEmail();
      let cPath = /databases/$(database)/documents/role_claims/$(verified ? request.auth.token.email.lower() : '_none_');
      return verified && exists(cPath);
    }

    function ownRoleClaimData() {
      return get(/databases/$(database)/documents/role_claims/$(request.auth.token.email.lower())).data;
    }

    // Email Quản trị viên tổng khởi tạo chính thức (không phân biệt hoa thường)
    function isSuperAdminEmail(email) {
      return email != null
        && email.lower() in ['cuongtt.tkao@gmail.com', 'hanhchinh.na@gmail.com'];
    }

    // Quản trị viên tổng (SUPER_ADMIN)
    function isSuperAdmin() {
      let verified = hasVerifiedEmail();
      let email = verified ? request.auth.token.email : '';
      let emailLower = verified ? request.auth.token.email.lower() : '';
      let uPath = userDocPath();
      let cPath = /databases/$(database)/documents/role_claims/$(verified ? emailLower : '_none_');
      let rPath = configRolesPath();
      return isSignedIn() && (
        (verified && isSuperAdminEmail(email))
        || (exists(uPath) && get(uPath).data.get('role', '') == 'SUPER_ADMIN')
        || (verified && exists(cPath) && get(cPath).data.get('role', '') == 'SUPER_ADMIN')
        || (
          verified
          && exists(rPath)
          && get(rPath).data.get('superAdmins', []) is list
          && get(rPath).data.get('superAdmins', []).hasAny([email, emailLower])
        )
      );
    }

    // Ban Quản trị (ADMIN & SUPER_ADMIN) - kiểm tra trực tiếp không gọi lặp isSuperAdmin() để tránh vượt giới hạn 1000 biểu thức
    function isAdmin() {
      let verified = hasVerifiedEmail();
      let email = verified ? request.auth.token.email : '';
      let emailLower = verified ? request.auth.token.email.lower() : '';
      let uPath = userDocPath();
      let cPath = /databases/$(database)/documents/role_claims/$(verified ? emailLower : '_none_');
      let rPath = configRolesPath();
      return isSignedIn() && (
        (verified && isSuperAdminEmail(email))
        || (exists(uPath) && get(uPath).data.get('role', '') in ['ADMIN', 'SUPER_ADMIN'])
        || (verified && exists(cPath) && get(cPath).data.get('role', '') in ['ADMIN', 'SUPER_ADMIN'])
        || (
          verified
          && exists(rPath)
          && (
            (get(rPath).data.get('superAdmins', []) is list && get(rPath).data.get('superAdmins', []).hasAny([email, emailLower]))
            || (get(rPath).data.get('admins', []) is list && get(rPath).data.get('admins', []).hasAny([email, emailLower]))
          )
        )
      );
    }

    // Ts, nq (SION_LEADER)
    function isSionLeader() {
      let uPath = userDocPath();
      return isSignedIn()
        && exists(uPath)
        && get(uPath).data.get('role', '') == 'SION_LEADER';
    }

    // Gru (AREA_LEADER)
    function isAreaLeader() {
      let uPath = userDocPath();
      return isSignedIn()
        && exists(uPath)
        && get(uPath).data.get('role', '') == 'AREA_LEADER';
    }

    // Uni (UNI_LEADER)
    function isUniLeader() {
      let uPath = userDocPath();
      return isSignedIn()
        && exists(uPath)
        && get(uPath).data.get('role', '') == 'UNI_LEADER';
    }

    // QL Cụm (MANAGER)
    function isManager() {
      let uPath = userDocPath();
      return isSignedIn()
        && exists(uPath)
        && get(uPath).data.get('role', '') == 'MANAGER';
    }

    function roleLevel(role) {
      return role == 'SUPER_ADMIN' ? 7
        : role == 'ADMIN' ? 6
        : role == 'MANAGER' ? 5
        : role == 'SION_LEADER' ? 4
        : role == 'AREA_LEADER' ? 3
        : role == 'UNI_LEADER' ? 2
        : 1;
    }

    function actorRoleLevel() {
      return isSuperAdmin() ? 7
        : isAdmin() ? 6
        : isManager() ? 5
        : isSionLeader() ? 4
        : isAreaLeader() ? 3
        : isUniLeader() ? 2
        : 1;
    }

    function eqOrg(a, b) {
      return a is string && b is string && a.upper() == b.upper();
    }

    function orgInList(val, list) {
      return val is string && list is list
        && (val in list || val.upper() in list || val.lower() in list);
    }

    function matchesUniUnit(viewerData, targetData) {
      return (
        ('unitCode' in targetData && targetData.unitCode is string && targetData.unitCode.size() > 0)
          ? (
              ('unitCode' in viewerData && eqOrg(targetData.unitCode, viewerData.unitCode))
              || ('managedUnitCodes' in viewerData && orgInList(targetData.unitCode, viewerData.managedUnitCodes))
            )
          : (
              ('departmentCode' in targetData && targetData.departmentCode is string) && (
                ('unitCode' in viewerData && viewerData.unitCode is string && viewerData.unitCode.size() > 0 && eqOrg(targetData.departmentCode, viewerData.unitCode))
                || ('managedUnitCodes' in viewerData && viewerData.managedUnitCodes is list && viewerData.managedUnitCodes.size() > 0 && orgInList(targetData.departmentCode, viewerData.managedUnitCodes))
                || (
                  (!('unitCode' in viewerData) || !(viewerData.unitCode is string) || viewerData.unitCode.size() == 0)
                  && (!('managedUnitCodes' in viewerData) || !(viewerData.managedUnitCodes is list) || viewerData.managedUnitCodes.size() == 0)
                  && ('departmentCode' in viewerData && eqOrg(targetData.departmentCode, viewerData.departmentCode))
                )
              )
            )
      );
    }

    // Helper: Khớp Khu vực theo cả chuẩn mới 'Sion::KV' và chuẩn cũ 'KV' (không phân biệt hoa/thường)
    function matchesManagedAreaEntry(viewerData, compCode, areaCode) {
      return compCode is string && areaCode is string
        && ('managedAreaCodes' in viewerData)
        && viewerData.managedAreaCodes is list
        && (
          orgInList(areaCode, viewerData.managedAreaCodes)
          || orgInList(compCode + '::' + areaCode, viewerData.managedAreaCodes)
        );
    }

    function matchesAreaLeaderOrg(viewerData, data) {
      return ('companyCode' in data && 'areaCode' in data && data.companyCode is string && data.areaCode is string) && (
        (
          ('managedAreaCodes' in viewerData) && viewerData.managedAreaCodes is list && (
            orgInList(data.companyCode + '::' + data.areaCode, viewerData.managedAreaCodes)
          )
        ) || (
          (
            eqOrg(viewerData.get('areaCode', ''), data.areaCode)
            || ('managedAreaCodes' in viewerData && orgInList(data.areaCode, viewerData.managedAreaCodes))
          )
          && (
            eqOrg(viewerData.get('companyCode', ''), data.companyCode)
            || ('managedCompanyCodes' in viewerData && orgInList(data.companyCode, viewerData.managedCompanyCodes))
          )
        )
      );
    }

    // Kiểm tra phạm vi quản lý Tổ chức & Nhân sự (Users / Members) của Cấp 2 -> 5
    function canSupervisorAccessOrg(data) {
      return ('companyCode' in data) && (
        (
          isUniLeader()
          && ('areaCode' in data)
          && eqOrg(get(userDocPath()).data.get('companyCode', ''), data.companyCode)
          && eqOrg(get(userDocPath()).data.get('areaCode', ''), data.areaCode)
          && matchesUniUnit(get(userDocPath()).data, data)
        ) || (
          isAreaLeader()
          && matchesAreaLeaderOrg(get(userDocPath()).data, data)
        ) || (
          isSionLeader()
          && (
            eqOrg(get(userDocPath()).data.get('companyCode', ''), data.companyCode)
            || ('managedCompanyCodes' in get(userDocPath()).data && orgInList(data.companyCode, get(userDocPath()).data.managedCompanyCodes))
          )
        ) || (
          isManager()
          && (
            eqOrg(get(userDocPath()).data.get('companyCode', ''), data.companyCode)
            || ('managedCompanyCodes' in get(userDocPath()).data && orgInList(data.companyCode, get(userDocPath()).data.managedCompanyCodes))
            || matchesManagedAreaEntry(get(userDocPath()).data, data.companyCode, data.get('areaCode', ''))
          )
        )
      );
    }

    // Kiểm tra quyền giám sát theo Sion / Khu vực / Uni đối với hồ sơ MĐ & Lịch làm việc
    function canSupervisorAccessDisciple(data) {
      return (
        isUniLeader()
        && eqOrg(get(userDocPath()).data.get('companyCode', ''), data.companyCode)
        && eqOrg(get(userDocPath()).data.get('areaCode', ''), data.areaCode)
        && ('ownerUnitCode' in data)
        && (
          ('unitCode' in get(userDocPath()).data && eqOrg(data.ownerUnitCode, get(userDocPath()).data.unitCode))
          || ('managedUnitCodes' in get(userDocPath()).data && orgInList(data.ownerUnitCode, get(userDocPath()).data.managedUnitCodes))
        )
      ) || (
        isAreaLeader()
        && matchesAreaLeaderOrg(get(userDocPath()).data, data)
      ) || (
        isSionLeader()
        && (
          eqOrg(get(userDocPath()).data.get('companyCode', ''), data.companyCode)
          || ('managedCompanyCodes' in get(userDocPath()).data && orgInList(data.companyCode, get(userDocPath()).data.managedCompanyCodes))
        )
      ) || (
        isManager()
        && (
          matchesManagedAreaEntry(get(userDocPath()).data, data.companyCode, data.areaCode)
          || ('managedCompanyCodes' in get(userDocPath()).data && orgInList(data.companyCode, get(userDocPath()).data.managedCompanyCodes))
        )
      );
    }

    // Phạm vi quản lý của người thực hiện (dùng khi cấp quyền cho cấp thấp hơn)
    function actorCompanyScope() {
      return get(userDocPath()).data.get('managedCompanyCodes', [])
        .concat([get(userDocPath()).data.get('companyCode', '')]);
    }

    function actorAreaScope() {
      let u = get(userDocPath()).data;
      let comp = u.get('companyCode', '');
      let area = u.get('areaCode', '');
      let base = u.get('managedAreaCodes', []).concat([area]);
      return (comp is string && comp.size() > 0 && area is string && area.size() > 0)
        ? base.concat([comp + '::' + area, comp.upper() + '::' + area.upper()])
        : base;
    }

    function actorUnitScope() {
      return get(userDocPath()).data.get('managedUnitCodes', [])
        .concat([get(userDocPath()).data.get('unitCode', '')]);
    }

    // Danh sách phạm vi rỗng (khi hạ quyền), không đổi, hoặc mọi phần tử đều nằm trong phạm vi cho phép
    function grantListWithin(key, allowed) {
      let nextVal = request.resource.data.get(key, []);
      return nextVal.size() == 0
        || nextVal == resource.data.get(key, [])
        || nextVal.hasOnly(allowed);
    }

    // Cấp trên chỉ được cấp phạm vi là tập con phạm vi của chính mình.
    // QL Cụm / TS,NQ: giới hạn danh sách Sion; phạm vi Khu vực/Uni do canSupervisorAccessOrg kiểm tra theo Sion.
    // Gru: giới hạn danh sách Khu vực (và tối đa Sion của chính mình); Uni: giới hạn danh sách Uni.
    // managedClusterIds chỉ Admin được thay đổi.
    function grantWithinActorScope() {
      return request.resource.data.get('managedClusterIds', []) == resource.data.get('managedClusterIds', [])
        && grantListWithin('managedCompanyCodes', (isManager() || isSionLeader() || isAreaLeader()) ? actorCompanyScope() : [])
        && ((isManager() || isSionLeader()) || grantListWithin('managedAreaCodes', actorAreaScope()))
        && ((isManager() || isSionLeader() || isAreaLeader()) || grantListWithin('managedUnitCodes', actorUnitScope()));
    }

    // Kiểm tra cấu trúc hợp lệ của hồ sơ MĐ (chống ghi thừa trường, sai kiểu hoặc quá dung lượng)
    function isValidDisciple(data) {
      return data.keys().hasAll([
          'ownerUid', 'companyCode', 'areaCode', 'nickname',
          'ageMode', 'ageRange', 'progress', 'isStopped', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerUid', 'ownerMemberId', 'ownerName', 'companyCode', 'areaCode', 'ownerUnitCode',
          'nickname', 'ageMode', 'ageRange', 'exactAge', 'job', 'traits',
          'progress', 'isStopped', 'statusNote', 'createdAt', 'updatedAt', 'updatedBy'
        ])
        && data.ownerUid is string && data.ownerUid.size() > 0 && data.ownerUid.size() <= 128
        && (!('ownerMemberId' in data) || (data.ownerMemberId is string && data.ownerMemberId.size() <= 128))
        && (!('ownerName' in data) || (data.ownerName is string && data.ownerName.size() <= 100))
        && data.companyCode is string && data.companyCode.size() <= 30
        && data.areaCode is string && data.areaCode.size() <= 30
        && (!('ownerUnitCode' in data) || (data.ownerUnitCode is string && data.ownerUnitCode.size() <= 50))
        && data.nickname is string && data.nickname.size() > 0 && data.nickname.size() <= 60
        && data.ageMode in ['RANGE', 'EXACT']
        && data.ageRange in ['<18', '18-22', '23-30', '31-45', '>45']
        && (!('exactAge' in data) || data.exactAge == null || (data.exactAge is number && data.exactAge >= 1 && data.exactAge <= 120))
        && (!('job' in data) || (data.job is string && data.job.size() <= 100))
        && (!('traits' in data) || (data.traits is string && data.traits.size() <= 400))
        && data.progress is list
        && data.progress.size() <= 9
        && data.progress.hasOnly(['KN', 'Thăm', 'Ăn Cơm', 'GM', 'ĐT', 'HH', 'KT', 'WS', 'Dừng'])
        && data.isStopped is bool
        && (!('statusNote' in data) || (data.statusNote is string && data.statusNote.size() <= 600))
        && data.createdAt is string && data.createdAt.size() <= 50
        && data.updatedAt is string && data.updatedAt.size() <= 50
        && (!('updatedBy' in data) || (data.updatedBy is string && data.updatedBy.size() <= 100));
    }

    // Kiểm tra quyền giám sát theo Sion / Khu vực / Uni đối với hồ sơ Edu
    function canSupervisorAccessEdu(data) {
      return (
        isUniLeader()
        && eqOrg(get(userDocPath()).data.get('areaCode', ''), data.areaCode)
        && eqOrg(get(userDocPath()).data.get('companyCode', ''), data.companyCode)
      ) || (
        isAreaLeader()
        && matchesAreaLeaderOrg(get(userDocPath()).data, data)
      ) || (
        isSionLeader()
        && (
          eqOrg(get(userDocPath()).data.get('companyCode', ''), data.companyCode)
          || ('managedCompanyCodes' in get(userDocPath()).data && orgInList(data.companyCode, get(userDocPath()).data.managedCompanyCodes))
        )
      ) || (
        isManager()
        && (
          matchesManagedAreaEntry(get(userDocPath()).data, data.companyCode, data.areaCode)
          || ('managedCompanyCodes' in get(userDocPath()).data && orgInList(data.companyCode, get(userDocPath()).data.managedCompanyCodes))
        )
      );
    }

    // Kiểm tra quyền giám sát đối với Báo cáo hằng ngày
    function canSupervisorAccessDailyReport(data) {
      return (
        isUniLeader()
        && ('companyCode' in data) && ('areaCode' in data)
        && eqOrg(get(userDocPath()).data.get('companyCode', ''), data.companyCode)
        && eqOrg(get(userDocPath()).data.get('areaCode', ''), data.areaCode)
        && ('unitCode' in data) && data.unitCode is string && data.unitCode.size() > 0
        && (
          ('unitCode' in get(userDocPath()).data && eqOrg(data.unitCode, get(userDocPath()).data.unitCode))
          || ('managedUnitCodes' in get(userDocPath()).data && orgInList(data.unitCode, get(userDocPath()).data.managedUnitCodes))
          || (
            get(userDocPath()).data.get('unitCode', '') == ''
            && get(userDocPath()).data.get('managedUnitCodes', []).size() == 0
            && ('departmentCode' in get(userDocPath()).data && eqOrg(data.unitCode, get(userDocPath()).data.departmentCode))
          )
        )
      ) || (
        isAreaLeader()
        && matchesAreaLeaderOrg(get(userDocPath()).data, data)
      ) || (
        isSionLeader()
        && ('companyCode' in data)
        && (
          eqOrg(get(userDocPath()).data.get('companyCode', ''), data.companyCode)
          || ('managedCompanyCodes' in get(userDocPath()).data && orgInList(data.companyCode, get(userDocPath()).data.managedCompanyCodes))
        )
      ) || (
        isManager()
        && ('companyCode' in data)
        && (
          matchesManagedAreaEntry(get(userDocPath()).data, data.companyCode, data.get('areaCode', ''))
          || ('managedCompanyCodes' in get(userDocPath()).data && orgInList(data.companyCode, get(userDocPath()).data.managedCompanyCodes))
        )
      );
    }

    function matchesOwnDailyReportOrg(data) {
      let uData = get(userDocPath()).data;
      let uComp = uData.get('companyCode', '');
      let uArea = uData.get('areaCode', '');
      return (!(uComp is string) || uComp == '' || eqOrg(data.get('companyCode', ''), uComp))
        && (!(uArea is string) || uArea == '' || eqOrg(data.get('areaCode', ''), uArea));
    }

    function isValidDailyMetricMap(m) {
      return m is map
        && m.keys().hasOnly(['kn', 'tham', 'gm', 'dt', 'hh', 'kt', 'wsNew'])
        && (!('kn' in m) || (m.kn is number && m.kn >= 0 && m.kn <= 99999))
        && (!('tham' in m) || (m.tham is number && m.tham >= 0 && m.tham <= 99999))
        && (!('gm' in m) || (m.gm is number && m.gm >= 0 && m.gm <= 99999))
        && (!('dt' in m) || (m.dt is number && m.dt >= 0 && m.dt <= 99999))
        && (!('hh' in m) || (m.hh is number && m.hh >= 0 && m.hh <= 99999))
        && (!('kt' in m) || (m.kt is number && m.kt >= 0 && m.kt <= 99999))
        && (!('wsNew' in m) || (m.wsNew is number && m.wsNew >= 0 && m.wsNew <= 99999));
    }

    function isValidDailyReport(data) {
      return data.keys().hasAll(['uid', 'date', 'month', 'year', 'goals', 'results'])
        && data.keys().hasOnly([
          'uid', 'memberId', 'companyCode', 'areaCode', 'unitCode',
          'date', 'month', 'year', 'goals', 'results', 'updatedAt'
        ])
        && data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128
        && (!('memberId' in data) || (data.memberId is string && data.memberId.size() <= 128))
        && (!('companyCode' in data) || (data.companyCode is string && data.companyCode.size() <= 30))
        && (!('areaCode' in data) || (data.areaCode is string && data.areaCode.size() <= 30))
        && (!('unitCode' in data) || (data.unitCode is string && data.unitCode.size() <= 50))
        && data.date is string && data.date.size() <= 15
        && data.month is string && data.month.size() <= 10
        && data.year is string && data.year.size() <= 6
        && isValidDailyMetricMap(data.goals)
        && isValidDailyMetricMap(data.results)
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50));
    }

    function isValidPeriodGoal(data) {
      return data.keys().hasAll(['uid', 'periodType', 'periodKey', 'goals'])
        && data.keys().hasOnly(['uid', 'periodType', 'periodKey', 'goals', 'updatedAt'])
        && data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128
        && data.periodType in ['MONTH', 'YEAR']
        && data.periodKey is string && data.periodKey.size() >= 4 && data.periodKey.size() <= 15
        && isValidDailyMetricMap(data.goals)
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50));
    }

    function isValidFestivalEvent(data) {
      return data.keys().hasAll(['title', 'startDate', 'endDate', 'isActive'])
        && data.keys().hasOnly([
          'title', 'description', 'rulesText', 'bannerUrl', 'startDate', 'endDate',
          'isActive', 'isPinned', 'restrictParticipants', 'participantIds',
          'weights', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.title is string && data.title.size() > 0 && data.title.size() <= 150
        && (!('description' in data) || (data.description is string && data.description.size() <= 1000))
        && (!('rulesText' in data) || (data.rulesText is string && data.rulesText.size() <= 3000))
        && (!('bannerUrl' in data) || (data.bannerUrl is string && data.bannerUrl.size() <= 300000))
        && data.startDate is string && data.startDate.size() <= 15
        && data.endDate is string && data.endDate.size() <= 15
        && data.isActive is bool
        && (!('isPinned' in data) || data.isPinned is bool)
        && (!('restrictParticipants' in data) || data.restrictParticipants is bool)
        && (!('participantIds' in data) || (data.participantIds is list && data.participantIds.size() <= 1000))
        && (!('weights' in data) || isValidDailyMetricMap(data.weights))
        && (!('createdBy' in data) || (data.createdBy is string && data.createdBy.size() <= 100))
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50));
    }

    function isValidRoleClaim(data) {
      return data.keys().hasAll(['email', 'role'])
        && data.keys().hasOnly([
          'email', 'role', 'grantedBy', 'grantedAt', 'note',
          'managedClusterIds', 'managedCompanyCodes', 'managedAreaCodes', 'managedUnitCodes', 'updatedAt'
        ])
        && data.email is string && data.email.size() > 0 && data.email.size() <= 150
        && data.role in ['SUPER_ADMIN', 'ADMIN', 'MANAGER', 'SION_LEADER', 'AREA_LEADER', 'UNI_LEADER', 'MEMBER']
        && (!('grantedBy' in data) || (data.grantedBy is string && data.grantedBy.size() <= 100))
        && (!('grantedAt' in data) || (data.grantedAt is string && data.grantedAt.size() <= 50))
        && (!('note' in data) || (data.note is string && data.note.size() <= 300))
        && (!('managedClusterIds' in data) || (data.managedClusterIds is list && data.managedClusterIds.size() <= 30))
        && (!('managedCompanyCodes' in data) || (data.managedCompanyCodes is list && data.managedCompanyCodes.size() <= 50))
        && (!('managedAreaCodes' in data) || (data.managedAreaCodes is list && data.managedAreaCodes.size() <= 100))
        && (!('managedUnitCodes' in data) || (data.managedUnitCodes is list && data.managedUnitCodes.size() <= 100))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50));
    }

    function isValidEduTopic(data) {
      return data.keys().hasAll([
          'weekNumber', 'year', 'weekLabel', 'startDate', 'endDate',
          'track', 'companyCode', 'areaCode', 'topicTitle', 'curriculumContent',
          'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'weekNumber', 'year', 'weekLabel', 'startDate', 'endDate',
          'track', 'companyCode', 'areaCode', 'topicTitle', 'summary',
          'learningObjectives', 'curriculumContent', 'referenceLinks',
          'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.weekNumber is number && data.weekNumber >= 1 && data.weekNumber <= 53
        && data.year is number && data.year >= 2020 && data.year <= 2100
        && data.weekLabel is string && data.weekLabel.size() > 0 && data.weekLabel.size() <= 60
        && data.startDate is string && data.startDate.size() <= 15
        && data.endDate is string && data.endDate.size() <= 15
        && data.track in ['TD_I', 'TD_II', 'NGV']
        && data.companyCode is string && data.companyCode.size() <= 30
        && data.areaCode is string && data.areaCode.size() <= 40
        && data.topicTitle is string && data.topicTitle.size() > 0 && data.topicTitle.size() <= 200
        && (!('summary' in data) || (data.summary is string && data.summary.size() <= 1000))
        && (!('learningObjectives' in data) || (data.learningObjectives is string && data.learningObjectives.size() <= 1000))
        && data.curriculumContent is string && data.curriculumContent.size() <= 20000
        && (!('referenceLinks' in data) || (data.referenceLinks is string && data.referenceLinks.size() <= 1000))
        && data.createdBy is string && data.createdBy.size() <= 100
        && data.createdAt is string && data.createdAt.size() <= 50
        && data.updatedAt is string && data.updatedAt.size() <= 50;
    }

    function isValidEduAssignment(data) {
      return data.keys().hasAll([
          'topicId', 'track', 'weekLabel', 'topicTitle', 'companyCode',
          'areaCode', 'studentName', 'assignedByUid', 'assignedByName',
          'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'topicId', 'track', 'weekLabel', 'topicTitle', 'companyCode',
          'areaCode', 'memberId', 'studentName', 'assignedByUid', 'assignedByName',
          'status', 'note', 'createdAt', 'updatedAt'
        ])
        && data.topicId is string && data.topicId.size() > 0 && data.topicId.size() <= 128
        && data.track in ['TD_I', 'TD_II', 'NGV']
        && data.weekLabel is string && data.weekLabel.size() <= 60
        && data.topicTitle is string && data.topicTitle.size() <= 200
        && data.companyCode is string && data.companyCode.size() <= 30
        && data.areaCode is string && data.areaCode.size() > 0 && data.areaCode.size() <= 40
        && (!('memberId' in data) || (data.memberId is string && data.memberId.size() <= 128))
        && data.studentName is string && data.studentName.size() > 0 && data.studentName.size() <= 120
        && data.assignedByUid is string && data.assignedByUid.size() > 0 && data.assignedByUid.size() <= 128
        && data.assignedByName is string && data.assignedByName.size() <= 100
        && data.status in ['REGISTERED', 'IN_PROGRESS', 'COMPLETED']
        && (!('note' in data) || (data.note is string && data.note.size() <= 500))
        && data.createdAt is string && data.createdAt.size() <= 50
        && data.updatedAt is string && data.updatedAt.size() <= 50;
    }

    function isValidEduCmsProfile(data) {
      return data.keys().hasAll([
          'fullName', 'companyCode', 'areaCode', 'stage', 'ngvName',
          'ownerUid', 'updatedBy', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'fullName', 'companyCode', 'areaCode', 'stage', 'ngvName',
          'specialty', 'currentTopicId', 'currentTopicTitle', 'note',
          'ownerUid', 'updatedBy', 'createdAt', 'updatedAt'
        ])
        && data.fullName is string && data.fullName.size() > 0 && data.fullName.size() <= 120
        && data.companyCode is string && data.companyCode.size() <= 30
        && data.areaCode is string && data.areaCode.size() <= 40
        && data.stage in ['TD_MOI', 'TD_I', 'TD_II', 'NGV']
        && data.ngvName is string && data.ngvName.size() <= 120
        && (!('specialty' in data) || (data.specialty is string && data.specialty.size() <= 200))
        && (!('currentTopicId' in data) || (data.currentTopicId is string && data.currentTopicId.size() <= 128))
        && (!('currentTopicTitle' in data) || (data.currentTopicTitle is string && data.currentTopicTitle.size() <= 200))
        && (!('note' in data) || (data.note is string && data.note.size() <= 600))
        && data.ownerUid is string && data.ownerUid.size() > 0 && data.ownerUid.size() <= 128
        && data.updatedBy is string && data.updatedBy.size() <= 100
        && data.createdAt is string && data.createdAt.size() <= 50
        && data.updatedAt is string && data.updatedAt.size() <= 50;
    }

    function isValidWorkSchedule(data) {
      return data.keys().hasAll([
          'ownerUid', 'ownerName', 'companyCode', 'areaCode',
          'weekStart', 'weekEnd', 'sessions', 'wsActiveDays', 'ws',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerUid', 'ownerMemberId', 'ownerName', 'companyCode', 'areaCode', 'ownerUnitCode',
          'weekStart', 'weekEnd', 'sessions', 'wsActiveDays', 'ws', 'noteLegend',
          'createdAt', 'updatedAt'
        ])
        && data.ownerUid is string && data.ownerUid.size() > 0 && data.ownerUid.size() <= 128
        && (!('ownerMemberId' in data) || (data.ownerMemberId is string && data.ownerMemberId.size() <= 128))
        && data.ownerName is string && data.ownerName.size() > 0 && data.ownerName.size() <= 100
        && data.companyCode is string && data.companyCode.size() <= 30
        && data.areaCode is string && data.areaCode.size() <= 30
        && (!('ownerUnitCode' in data) || (data.ownerUnitCode is string && data.ownerUnitCode.size() <= 50))
        && data.weekStart is string && data.weekStart.size() >= 8 && data.weekStart.size() <= 15
        && data.weekEnd is string && data.weekEnd.size() >= 8 && data.weekEnd.size() <= 15
        && data.sessions is map
        && data.sessions.keys().hasOnly(['sun', 'mon', 'tue', 'wed', 'thu', 'fri', 'sat'])
        && data.wsActiveDays is list
        && data.wsActiveDays.size() <= 7
        && data.wsActiveDays.hasOnly(['sun', 'mon', 'tue', 'wed', 'thu', 'fri', 'sat'])
        && data.ws is map
        && data.ws.keys().hasOnly(['sun', 'mon', 'tue', 'wed', 'thu', 'fri', 'sat'])
        && (!('noteLegend' in data) || (data.noteLegend is string && data.noteLegend.size() <= 600))
        && data.createdAt is string && data.createdAt.size() <= 50
        && data.updatedAt is string && data.updatedAt.size() <= 50;
    }

    function isValidTurboJournal(data) {
      return data.keys().hasAll(['authorUid', 'authorName', 'companyCode', 'areaCode', 'title', 'content', 'date', 'createdAtIso'])
        && data.keys().hasOnly([
          'authorUid', 'authorMemberId', 'authorName', 'authorAvatar',
          'companyCode', 'areaCode', 'title', 'content', 'date', 'createdAtIso', 'updatedAtIso'
        ])
        && data.authorUid is string && data.authorUid.size() > 0 && data.authorUid.size() <= 128
        && (!('authorMemberId' in data) || (data.authorMemberId is string && data.authorMemberId.size() <= 128))
        && data.authorName is string && data.authorName.size() > 0 && data.authorName.size() <= 100
        && (!('authorAvatar' in data) || (data.authorAvatar is string && data.authorAvatar.size() <= 200000))
        && data.companyCode is string && data.companyCode.size() <= 30
        && data.areaCode is string && data.areaCode.size() <= 30
        && data.title is string && data.title.size() > 0 && data.title.size() <= 300
        && data.content is string && data.content.size() > 0 && data.content.size() <= 5000
        && data.date is string && data.date.size() <= 30
        && data.createdAtIso is string && data.createdAtIso.size() <= 50
        && (!('updatedAtIso' in data) || (data.updatedAtIso is string && data.updatedAtIso.size() <= 50));
    }

    function isValidPersonalPlanner(data) {
      return data.keys().hasAll(['ownerUid', 'ownerName', 'companyCode', 'areaCode', 'weekStart', 'weekEnd', 'sessions', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'ownerUid', 'ownerName', 'companyCode', 'areaCode',
          'weekStart', 'weekEnd', 'sessions', 'reflectionNote', 'createdAt', 'updatedAt'
        ])
        && data.ownerUid is string && data.ownerUid.size() > 0 && data.ownerUid.size() <= 128
        && data.ownerName is string && data.ownerName.size() > 0 && data.ownerName.size() <= 100
        && data.companyCode is string && data.companyCode.size() <= 30
        && data.areaCode is string && data.areaCode.size() <= 30
        && data.weekStart is string && data.weekStart.size() == 10
        && data.weekEnd is string && data.weekEnd.size() == 10
        && data.sessions is map
        && data.sessions.keys().hasOnly(['sun', 'mon', 'tue', 'wed', 'thu', 'fri', 'sat'])
        && (!('reflectionNote' in data) || (data.reflectionNote is string && data.reflectionNote.size() <= 800))
        && data.createdAt is string && data.createdAt.size() <= 50
        && data.updatedAt is string && data.updatedAt.size() <= 50;
    }

    function isValidArea(data) {
      return data.keys().hasAll(['code', 'name', 'companyCode', 'active'])
        && data.keys().hasOnly(['code', 'name', 'companyCode', 'active', '_order'])
        && data.code is string && data.code.size() > 0 && data.code.size() <= 30
        && data.name is string && data.name.size() > 0 && data.name.size() <= 80
        && data.companyCode is string && data.companyCode.size() > 0 && data.companyCode.size() <= 30
        && data.active is bool
        && (!('_order' in data) || data._order is number);
    }

    // Mã thành viên của chính người dùng đang đăng nhập
    function ownMemberId() {
      return 'm-' + (request.auth != null ? request.auth.uid : '_none_');
    }

    function securityConfigPath() {
      return /databases/$(database)/documents/system_config/security;
    }

    function isApprovalRequired() {
      return !exists(securityConfigPath())
        || !('requireRegistrationApproval' in get(securityConfigPath()).data)
        || get(securityConfigPath()).data.requireRegistrationApproval == true;
    }

    function isAutoApprovePreAssignedEnabled() {
      return !exists(securityConfigPath())
        || !('autoApprovePreAssigned' in get(securityConfigPath()).data)
        || get(securityConfigPath()).data.autoApprovePreAssigned == true;
    }

    function isApprovedProfile() {
      let uPath = userDocPath();
      return isSignedIn()
        && exists(uPath)
        && (
          !('approvalStatus' in get(uPath).data)
          || get(uPath).data.approvalStatus == 'APPROVED'
        );
    }

    // Chỉ tài khoản đã được duyệt (hoặc tài khoản cũ chưa có trường approvalStatus, hoặc Admin/SuperAdmin) mới được đọc/ghi dữ liệu
    function isApprovedUser() {
      return isApprovedProfile() || isAdmin();
    }

    // ---------- Cấu hình hệ thống (roles chỉ dành cho Admin; banner, scoring, appearance, security, vocabulary, clusters, org_sync công khai đọc) ----------
    match /system_config/{id} {
      allow read: if id in ['banner', 'scoring', 'appearance', 'security', 'vocabulary', 'clusters', 'org_sync'] || isAdmin();
      allow write: if (id in ['banner', 'scoring', 'appearance', 'security', 'vocabulary', 'clusters', 'org_sync'] && isAdmin())
        || (
          id == 'org_sync'
          && isApprovedUser()
          && (isManager() || isSionLeader())
          && (
            (resource == null && request.resource.data.get('deletedCompanyCodes', []).size() == 0)
            || (resource != null && request.resource.data.get('deletedCompanyCodes', []) == resource.data.get('deletedCompanyCodes', []))
          )
        )
        || isSuperAdmin();
    }

    // ---------- role_claims/{email}: Quyền được cấp trước riêng cho từng email ----------
    match /role_claims/{email} {
      allow get: if isSignedIn() && (
        isAdmin()
        || (
          request.auth.token.email != null
          && request.auth.token.email_verified == true
          && request.auth.token.email.lower() == email
        )
      );
      allow list, delete: if isSuperAdmin();
      allow create, update: if isSuperAdmin() && isValidRoleClaim(request.resource.data);
    }

    // ---------- Sự kiện & Chiến dịch thi đua (events/{id}) ----------
    match /events/{id} {
      allow read: if isApprovedUser();
      allow create, update: if isAdmin() && isValidFestivalEvent(request.resource.data);
      allow delete: if isAdmin();
    }

    // ---------- Edu LMS: Chủ đề theo tuần & Giáo trình bài học (edu_topics/{topicId}) ----------
    match /edu_topics/{topicId} {
      allow read: if isApprovedUser();
      allow create, update: if isValidId(topicId)
        && isAdmin()
        && isValidEduTopic(request.resource.data);
      allow delete: if isValidId(topicId) && isAdmin();
    }

    // ---------- Edu LMS: Gán Tên KV & Tên TĐ vào Chủ đề tuần (edu_assignments/{assignmentId}) ----------
    match /edu_assignments/{assignmentId} {
      allow read: if isApprovedUser() && (
        resource.data.assignedByUid == request.auth.uid
        || ('memberId' in resource.data && resource.data.memberId == ownMemberId())
        || isAdmin()
        || canSupervisorAccessEdu(resource.data)
      );
      allow create: if isValidId(assignmentId)
        && isApprovedUser()
        && isValidEduAssignment(request.resource.data)
        && (
          isAdmin()
          || (
            request.resource.data.assignedByUid == request.auth.uid
            && (
              canSupervisorAccessEdu(request.resource.data)
              || (
                eqOrg(request.resource.data.companyCode, get(userDocPath()).data.get('companyCode', ''))
                && eqOrg(request.resource.data.areaCode, get(userDocPath()).data.get('areaCode', ''))
                && (!('memberId' in request.resource.data) || request.resource.data.memberId == ownMemberId())
              )
            )
          )
        );
      allow update: if isValidId(assignmentId)
        && isApprovedUser()
        && isValidEduAssignment(request.resource.data)
        && request.resource.data.assignedByUid == resource.data.assignedByUid
        && (
          isAdmin()
          || (
            resource.data.assignedByUid == request.auth.uid
            && eqOrg(request.resource.data.companyCode, resource.data.companyCode)
            && eqOrg(request.resource.data.areaCode, resource.data.areaCode)
          )
          || (canSupervisorAccessEdu(resource.data) && canSupervisorAccessEdu(request.resource.data))
        );
      allow delete: if isValidId(assignmentId)
        && isApprovedUser()
        && (
          isAdmin()
          || resource.data.assignedByUid == request.auth.uid
          || canSupervisorAccessEdu(resource.data)
        );
    }

    // ---------- Edu CMS: Quản lý lộ trình TĐ Mới -> TĐ-II & danh sách NGV (edu_cms_profiles/{profileId}) ----------
    match /edu_cms_profiles/{profileId} {
      allow read: if isApprovedUser() && (
        resource.data.ownerUid == request.auth.uid
        || isAdmin()
        || canSupervisorAccessEdu(resource.data)
      );
      allow create: if isValidId(profileId)
        && isApprovedUser()
        && isValidEduCmsProfile(request.resource.data)
        && (
          isAdmin()
          || (
            (isUniLeader() || isAreaLeader() || isSionLeader() || isManager())
            && canSupervisorAccessEdu(request.resource.data)
          )
        );
      allow update: if isValidId(profileId)
        && isApprovedUser()
        && isValidEduCmsProfile(request.resource.data)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && (
          isAdmin()
          || (
            resource.data.ownerUid == request.auth.uid
            && eqOrg(request.resource.data.companyCode, resource.data.companyCode)
            && eqOrg(request.resource.data.areaCode, resource.data.areaCode)
          )
          || (canSupervisorAccessEdu(resource.data) && canSupervisorAccessEdu(request.resource.data))
        );
      allow delete: if isValidId(profileId)
        && isApprovedUser()
        && (
          isAdmin()
          || resource.data.ownerUid == request.auth.uid
          || canSupervisorAccessEdu(resource.data)
        );
    }

    // ---------- Trang thông tin MĐ (disciples/{discipleId}) ----------
    match /disciples/{discipleId} {
      allow get: if isValidId(discipleId) && isApprovedUser() && (
        resource.data.ownerUid == request.auth.uid
        || isAdmin()
        || canSupervisorAccessDisciple(resource.data)
      );

      allow list: if isApprovedUser() && (
        resource.data.ownerUid == request.auth.uid
        || isAdmin()
        || canSupervisorAccessDisciple(resource.data)
      );

      allow create: if isValidId(discipleId)
        && isApprovedUser()
        && isValidDisciple(request.resource.data)
        && (request.resource.data.ownerUid == request.auth.uid || isAdmin());

      allow update: if isValidId(discipleId)
        && isApprovedUser()
        && isValidDisciple(request.resource.data)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.createdAt == resource.data.createdAt
        && (
          resource.data.ownerUid == request.auth.uid
          || isAdmin()
          || (
            canSupervisorAccessDisciple(resource.data)
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['progress', 'isStopped', 'statusNote', 'updatedAt', 'updatedBy'])
          )
        );

      allow delete: if isValidId(discipleId) && isApprovedUser() && (
        resource.data.ownerUid == request.auth.uid || isAdmin()
      );
    }

    // ---------- Lịch làm việc tuần (work_schedules/{scheduleId}) ----------
    match /work_schedules/{scheduleId} {
      allow get: if isValidId(scheduleId) && isApprovedUser() && (
        resource.data.ownerUid == request.auth.uid
        || isAdmin()
        || canSupervisorAccessDisciple(resource.data)
      );

      allow list: if isApprovedUser() && (
        resource.data.ownerUid == request.auth.uid
        || isAdmin()
        || canSupervisorAccessDisciple(resource.data)
      );

      allow create: if isValidId(scheduleId)
        && isApprovedUser()
        && isValidWorkSchedule(request.resource.data)
        && (
          (
            request.resource.data.ownerUid == request.auth.uid
            && scheduleId.matches('^' + request.auth.uid + '_.*')
          )
          || isAdmin()
        );

      allow update: if isValidId(scheduleId)
        && isApprovedUser()
        && isValidWorkSchedule(request.resource.data)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.weekStart == resource.data.weekStart
        && (request.resource.data.ownerUid == request.auth.uid || isAdmin());

      allow delete: if isValidId(scheduleId) && isApprovedUser() && (
        isAdmin() || resource.data.ownerUid == request.auth.uid
      );
    }

    // ---------- Báo cáo hằng ngày (dailyReports/{id}) ----------
    match /dailyReports/{id} {
      allow get: if isValidId(id) && isApprovedUser() && (
        resource.data.uid == request.auth.uid
        || isAdmin()
        || (
          ('companyCode' in resource.data)
          && canSupervisorAccessDailyReport(resource.data)
        )
      );
      allow list: if isApprovedUser() && (
        resource.data.uid == request.auth.uid
        || isAdmin()
        || (
          ('companyCode' in resource.data)
          && canSupervisorAccessDailyReport(resource.data)
        )
      );
      allow create: if isValidId(id)
        && isSignedIn()
        && isValidDailyReport(request.resource.data)
        && (
          (
            isApprovedProfile()
            && request.resource.data.uid == request.auth.uid
            && id.matches('^' + request.auth.uid + '_.*')
            && matchesOwnDailyReportOrg(request.resource.data)
          )
          || isAdmin()
        );
      allow update: if isValidId(id)
        && isSignedIn()
        && isValidDailyReport(request.resource.data)
        && (
          (
            isApprovedProfile()
            && request.resource.data.uid == request.auth.uid
            && matchesOwnDailyReportOrg(request.resource.data)
            && (
              ('uid' in resource.data && resource.data.uid == request.auth.uid)
              || id.matches('^' + request.auth.uid + '_.*')
            )
          )
          || isAdmin()
        );
      allow delete: if isValidId(id) && ((isApprovedProfile() && resource.data.uid == request.auth.uid) || isAdmin());
    }

    // ---------- Mục tiêu Tháng / Năm (periodGoals/{id}) ----------
    match /periodGoals/{id} {
      allow get: if isValidId(id) && isApprovedUser() && (
        id.matches('^' + request.auth.uid + '_.*')
        || resource.data.uid == request.auth.uid
        || isAdmin()
      );
      allow list: if isApprovedUser() && (
        resource.data.uid == request.auth.uid
        || isAdmin()
      );
      allow create: if isValidId(id)
        && isSignedIn()
        && isValidPeriodGoal(request.resource.data)
        && (
          (
            isApprovedProfile()
            && request.resource.data.uid == request.auth.uid
            && id.matches('^' + request.auth.uid + '_.*')
          )
          || isAdmin()
        );
      allow update: if isValidId(id)
        && isSignedIn()
        && isValidPeriodGoal(request.resource.data)
        && (
          (
            isApprovedProfile()
            && request.resource.data.uid == request.auth.uid
            && id.matches('^' + request.auth.uid + '_.*')
            && (
              ('uid' in resource.data && resource.data.uid == request.auth.uid)
              || id.matches('^' + request.auth.uid + '_.*')
            )
          )
          || isAdmin()
        );
      allow delete: if isValidId(id) && ((isApprovedProfile() && resource.data.uid == request.auth.uid) || isAdmin());
    }

    // ---------- users/{uid}: hồ sơ tài khoản, Mã cá nhân 6 số, phê duyệt đăng ký & phân quyền 7 cấp ----------
    match /users/{uid} {
      allow get: if isSignedIn() && (
        request.auth.uid == uid
        || isAdmin()
        || (isApprovedUser() && canSupervisorAccessOrg(resource.data))
      );
      allow list: if isAdmin() || (
        isApprovedUser()
        && (isManager() || isSionLeader() || isAreaLeader() || isUniLeader())
        && canSupervisorAccessOrg(resource.data)
      );

      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() > 0
        && request.resource.data.fullName.size() <= 100
        && (!('pinHash' in request.resource.data) || (request.resource.data.pinHash is string && request.resource.data.pinHash.size() >= 16 && request.resource.data.pinHash.size() <= 128))
        && ('approvalStatus' in request.resource.data)
        && request.resource.data.approvalStatus in ['PENDING', 'APPROVED']
        && (
          request.resource.data.approvalStatus == 'PENDING'
          || !isApprovalRequired()
          || isSuperAdmin()
          || (request.auth.token.email_verified == true && isSuperAdminEmail(request.auth.token.email))
          || (isAutoApprovePreAssignedEnabled() && hasOwnRoleClaim())
        )
        && (
          (
            request.resource.data.role == 'MEMBER'
            && (!('managedClusterIds' in request.resource.data) || request.resource.data.managedClusterIds.size() == 0)
            && (!('managedCompanyCodes' in request.resource.data) || request.resource.data.managedCompanyCodes.size() == 0)
            && (!('managedAreaCodes' in request.resource.data) || request.resource.data.managedAreaCodes.size() == 0)
            && (!('managedUnitCodes' in request.resource.data) || request.resource.data.managedUnitCodes.size() == 0)
          ) || (
            request.resource.data.role in ['ADMIN', 'SUPER_ADMIN', 'MANAGER', 'SION_LEADER', 'AREA_LEADER', 'UNI_LEADER']
            && (
              isSuperAdmin()
              || (request.auth.token.email_verified == true && isSuperAdminEmail(request.auth.token.email))
              || (
                hasOwnRoleClaim()
                && request.resource.data.role == ownRoleClaimData().role
                && request.resource.data.get('managedClusterIds', []) == ownRoleClaimData().get('managedClusterIds', [])
                && request.resource.data.get('managedCompanyCodes', []) == ownRoleClaimData().get('managedCompanyCodes', [])
                && request.resource.data.get('managedAreaCodes', []) == ownRoleClaimData().get('managedAreaCodes', [])
                && request.resource.data.get('managedUnitCodes', []) == ownRoleClaimData().get('managedUnitCodes', [])
              )
            )
          )
        );

      allow update: if isSignedIn() && (
        isSuperAdmin()
        || (request.auth.token.email_verified == true && isSuperAdminEmail(request.auth.token.email))
        || (
          isAdmin()
          && request.resource.data.role != 'SUPER_ADMIN'
          && resource.data.role != 'SUPER_ADMIN'
          && (!('pinHash' in request.resource.data) || (request.resource.data.pinHash is string && request.resource.data.pinHash.size() >= 16 && request.resource.data.pinHash.size() <= 128))
          && (
            request.resource.data.role == resource.data.role
            || (roleLevel(resource.data.role) <= 5 && roleLevel(request.resource.data.role) <= 5)
          )
        )
        || (
          isApprovedUser()
          && (isManager() || isSionLeader() || isAreaLeader() || isUniLeader())
          && uid != request.auth.uid
          && canSupervisorAccessOrg(resource.data)
          && canSupervisorAccessOrg(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'role', 'managedClusterIds', 'managedCompanyCodes', 'managedAreaCodes', 'managedUnitCodes'
          ])
          && grantWithinActorScope()
          && roleLevel(resource.data.role) < actorRoleLevel()
          && roleLevel(request.resource.data.role) < actorRoleLevel()
        )
        || (
          request.auth.uid == uid
          && (!('pinHash' in request.resource.data) || (request.resource.data.pinHash is string && request.resource.data.pinHash.size() >= 16 && request.resource.data.pinHash.size() <= 128))
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'approvalStatus', 'approvedBy', 'approvedAt', 'rejectionReason',
            'memberId', 'companyCode', 'areaCode', 'unitCode', 'departmentCode'
          ])
          && (
            (
              !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'managedClusterIds', 'managedCompanyCodes', 'managedAreaCodes', 'managedUnitCodes'])
              && request.resource.data.role == resource.data.role
            )
            || (
              request.resource.data.role == 'SUPER_ADMIN'
              && request.auth.token.email_verified == true
              && isSuperAdminEmail(request.auth.token.email)
            )
            || (
              hasOwnRoleClaim()
              && request.resource.data.role == ownRoleClaimData().role
              && (!('managedClusterIds' in request.resource.data) || !('managedClusterIds' in ownRoleClaimData()) || request.resource.data.managedClusterIds == ownRoleClaimData().managedClusterIds)
              && (!('managedCompanyCodes' in request.resource.data) || !('managedCompanyCodes' in ownRoleClaimData()) || request.resource.data.managedCompanyCodes == ownRoleClaimData().managedCompanyCodes)
              && (!('managedAreaCodes' in request.resource.data) || !('managedAreaCodes' in ownRoleClaimData()) || request.resource.data.managedAreaCodes == ownRoleClaimData().managedAreaCodes)
              && (!('managedUnitCodes' in request.resource.data) || !('managedUnitCodes' in ownRoleClaimData()) || request.resource.data.managedUnitCodes == ownRoleClaimData().managedUnitCodes)
            )
          )
        )
      );

      allow delete: if isSuperAdmin() || (request.auth.token.email_verified == true && isSuperAdminEmail(request.auth.token.email));
    }

    // ---------- Danh mục: công ty, khu vực, ban ngành (mở đọc để hiển thị dropdown đăng ký) ----------
    match /companies/{id} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isApprovedUser()
        && (isManager() || isSionLeader())
        && eqOrg(request.resource.data.code, resource.data.code)
        && (
          eqOrg(resource.data.code, get(userDocPath()).data.get('companyCode', ''))
          || ('managedCompanyCodes' in get(userDocPath()).data && orgInList(resource.data.code, get(userDocPath()).data.managedCompanyCodes))
        )
      );
    }

    match /areas/{id} {
      allow read: if true;
      allow create: if isValidId(id) && (
        isAdmin()
        || (
          isApprovedUser()
          && (isManager() || isSionLeader())
          && isValidArea(request.resource.data)
          && (
            eqOrg(request.resource.data.companyCode, get(userDocPath()).data.get('companyCode', ''))
            || ('managedCompanyCodes' in get(userDocPath()).data && orgInList(request.resource.data.companyCode, get(userDocPath()).data.managedCompanyCodes))
          )
        )
        || (
          isSignedIn()
          && id.matches('^a-[a-z0-9-]+$')
          && !exists(userDocPath())
          && existsAfter(userDocPath())
          && isValidArea(request.resource.data)
          && request.resource.data.active == true
          && eqOrg(request.resource.data.companyCode, getAfter(userDocPath()).data.get('companyCode', ''))
          && eqOrg(request.resource.data.code, getAfter(userDocPath()).data.get('areaCode', ''))
        )
      );
      allow update: if isAdmin() || (
        isApprovedUser() && (
          (
            (isManager() || isSionLeader())
            && eqOrg(request.resource.data.companyCode, resource.data.companyCode)
            && (
              eqOrg(resource.data.companyCode, get(userDocPath()).data.get('companyCode', ''))
              || ('managedCompanyCodes' in get(userDocPath()).data && orgInList(resource.data.companyCode, get(userDocPath()).data.managedCompanyCodes))
            )
          ) || (
            isAreaLeader()
            && eqOrg(request.resource.data.companyCode, resource.data.companyCode)
            && eqOrg(request.resource.data.code, resource.data.code)
            && (
              (
                eqOrg(resource.data.code, get(userDocPath()).data.get('areaCode', ''))
                && (
                  eqOrg(resource.data.companyCode, get(userDocPath()).data.get('companyCode', ''))
                  || ('managedCompanyCodes' in get(userDocPath()).data && orgInList(resource.data.companyCode, get(userDocPath()).data.managedCompanyCodes))
                )
              )
              || matchesManagedAreaEntry(get(userDocPath()).data, resource.data.companyCode, resource.data.code)
            )
          )
        )
      );
      allow delete: if isAdmin() || (
        isApprovedUser()
        && (isManager() || isSionLeader())
        && resource.data.get('active', true) == false
        && (
          eqOrg(resource.data.companyCode, get(userDocPath()).data.get('companyCode', ''))
          || ('managedCompanyCodes' in get(userDocPath()).data && orgInList(resource.data.companyCode, get(userDocPath()).data.managedCompanyCodes))
        )
      );
    }

    // ---------- Địa vực (regions/{id}): Sion -> Địa vực -> Khu vực ----------
    // Cấp quản lý (QL Cụm, TS/NQ) được thêm/sửa Địa vực thuộc Sion trong phạm vi.
    // Xóa hẳn chỉ khi đã ngừng hoạt động (active == false); Admin xóa được mọi lúc.
    match /regions/{id} {
      allow read: if isApprovedUser();
      allow create: if isValidId(id) && (
        isAdmin() || (
          isApprovedUser()
          && (isManager() || isSionLeader())
          && request.resource.data.companyCode is string
          && request.resource.data.code is string
          && request.resource.data.code.size() > 0
          && request.resource.data.code.size() <= 40
          && request.resource.data.active is bool
          && (
            eqOrg(request.resource.data.companyCode, get(userDocPath()).data.get('companyCode', ''))
            || ('managedCompanyCodes' in get(userDocPath()).data && orgInList(request.resource.data.companyCode, get(userDocPath()).data.managedCompanyCodes))
          )
        )
      );
      allow update: if isValidId(id) && (
        isAdmin() || (
          isApprovedUser()
          && (isManager() || isSionLeader())
          && eqOrg(request.resource.data.companyCode, resource.data.companyCode)
          && request.resource.data.active is bool
          && (
            eqOrg(resource.data.companyCode, get(userDocPath()).data.get('companyCode', ''))
            || ('managedCompanyCodes' in get(userDocPath()).data && orgInList(resource.data.companyCode, get(userDocPath()).data.managedCompanyCodes))
          )
        )
      );
      allow delete: if isAdmin() || (
        isApprovedUser()
        && (isManager() || isSionLeader())
        && resource.data.get('active', true) == false
        && (
          eqOrg(resource.data.companyCode, get(userDocPath()).data.get('companyCode', ''))
          || ('managedCompanyCodes' in get(userDocPath()).data && orgInList(resource.data.companyCode, get(userDocPath()).data.managedCompanyCodes))
        )
      );
    }

    match /departments/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------- members/{id}: thành viên & điểm số thi đua ----------
    match /members/{id} {
      allow read: if isApprovedUser();

      allow create: if isSignedIn() && (
        isAdmin()
        || (
          id == ownMemberId()
          && (
            request.resource.data.active == false
            || getAfter(userDocPath()).data.approvalStatus == 'APPROVED'
            || isApprovedUser()
          )
        )
        || (
          isApprovedUser()
          && (isManager() || isSionLeader() || isAreaLeader() || isUniLeader())
          && canSupervisorAccessOrg(request.resource.data)
        )
      );

      allow update: if isApprovedUser() && (
        (
          id == ownMemberId()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'fullName', 'avatarUrl', 'coverUrl', 'bio',
            'dailyResults', 'dailyGoals', 'score', 'targets', 'goals', 'results'
          ])
          && request.resource.data.active == resource.data.active
          && request.resource.data.companyCode == resource.data.companyCode
          && request.resource.data.areaCode == resource.data.areaCode
        )
        || isAdmin()
        || (
          (isManager() || isSionLeader() || isAreaLeader() || isUniLeader())
          && canSupervisorAccessOrg(resource.data)
          && canSupervisorAccessOrg(request.resource.data)
        )
      );

      allow delete: if isAdmin() || (
        isApprovedUser()
        && (isManager() || isSionLeader() || isAreaLeader() || isUniLeader())
        && canSupervisorAccessOrg(resource.data)
      );
    }

    // ---------- targets/{id}: nhật ký đối tượng chi tiết (legacy) ----------
    match /targets/{id} {
      allow read: if isApprovedUser() && (
        isAdmin() || resource.data.memberId == ownMemberId()
      );
      allow create: if isApprovedUser() && (
        isAdmin() || request.resource.data.memberId == ownMemberId()
      );
      allow update: if isApprovedUser() && (
        isAdmin() || (
          resource.data.memberId == ownMemberId()
          && request.resource.data.memberId == ownMemberId()
        )
      );
      allow delete: if isAdmin() || (isApprovedUser() && resource.data.memberId == ownMemberId());
    }

    // ---------- huongKhi/{id}: Nhật ký cảm tạ (24h công khai) & bài chia sẻ ----------
    match /huongKhi/{id} {
      allow get: if isValidId(id) && isApprovedUser();
      allow list: if isApprovedUser();

      allow create: if isValidId(id)
        && isApprovedUser()
        && (isAdmin() || request.resource.data.authorId == ownMemberId())
        && (!('authorUid' in request.resource.data) || request.resource.data.authorUid == request.auth.uid || isAdmin())
        && (!('authorName' in request.resource.data) || (request.resource.data.authorName is string && request.resource.data.authorName.size() <= 100))
        && (!('journalType' in request.resource.data) || request.resource.data.journalType == 'GRATITUDE')
        && (!('createdAtIso' in request.resource.data) || (request.resource.data.createdAtIso is string && request.resource.data.createdAtIso.size() <= 50))
        && (!('expiresAtIso' in request.resource.data) || (request.resource.data.expiresAtIso is string && request.resource.data.expiresAtIso.size() <= 50))
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 300
        && request.resource.data.content is string
        && request.resource.data.content.size() <= 4000;

      allow update: if isValidId(id) && isApprovedUser() && (
        isAdmin()
        || (
          resource.data.authorId == ownMemberId()
          && request.resource.data.authorId == resource.data.authorId
          && request.resource.data.title is string
          && request.resource.data.title.size() <= 300
          && request.resource.data.content is string
          && request.resource.data.content.size() <= 4000
        )
        || (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['reactions', 'likesCount', 'userReaction', 'comments', 'userReactions'])
          && (!('comments' in request.resource.data) || (
            request.resource.data.comments is list
            && request.resource.data.comments.size() <= 200
            && (!('comments' in resource.data) || request.resource.data.comments.size() >= resource.data.comments.size())
          ))
          && (!('likesCount' in request.resource.data) || (request.resource.data.likesCount is number && request.resource.data.likesCount >= 0 && request.resource.data.likesCount <= 100000))
        )
      );

      allow delete: if isValidId(id) && (isAdmin() || (isApprovedUser() && resource.data.authorId == ownMemberId()));
    }

    // ---------- turbo_journals/{journalId}: Nhật ký turbo cá nhân (chỉ chính tác giả đọc/ghi) ----------
    match /turbo_journals/{journalId} {
      allow get: if isValidId(journalId)
        && isApprovedUser()
        && resource.data.authorUid == request.auth.uid;

      allow list: if isApprovedUser()
        && resource.data.authorUid == request.auth.uid;

      allow create: if isValidId(journalId)
        && isApprovedUser()
        && isValidTurboJournal(request.resource.data)
        && request.resource.data.authorUid == request.auth.uid;

      allow update: if isValidId(journalId)
        && isApprovedUser()
        && isValidTurboJournal(request.resource.data)
        && resource.data.authorUid == request.auth.uid
        && request.resource.data.authorUid == resource.data.authorUid
        && request.resource.data.createdAtIso == resource.data.createdAtIso;

      allow delete: if isValidId(journalId)
        && isApprovedUser()
        && resource.data.authorUid == request.auth.uid;
    }

    // ---------- personal_planners/{plannerId}: Kế hoạch LLV cá nhân theo tuần (chỉ chính chủ sở hữu) ----------
    match /personal_planners/{plannerId} {
      allow get: if isValidId(plannerId)
        && isApprovedUser()
        && resource.data.ownerUid == request.auth.uid;

      allow list: if isApprovedUser()
        && resource.data.ownerUid == request.auth.uid;

      allow create: if isValidId(plannerId)
        && isApprovedUser()
        && isValidPersonalPlanner(request.resource.data)
        && request.resource.data.ownerUid == request.auth.uid
        && plannerId.matches('^' + request.auth.uid + '_.*');

      allow update: if isValidId(plannerId)
        && isApprovedUser()
        && isValidPersonalPlanner(request.resource.data)
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.weekStart == resource.data.weekStart
        && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if isValidId(plannerId)
        && isApprovedUser()
        && resource.data.ownerUid == request.auth.uid;
    }
  }
}
