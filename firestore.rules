rules_version = '2';

// ============================================================
//  Hành Thực Lục - Quy tắc bảo mật Firestore (7 cấp phân quyền)
//  - Admin Tổng / HT (SUPER_ADMIN): Toàn quyền cấu hình, phân quyền tất cả các cấp.
//  - Ban Quản Trị HT (ADMIN): Quản lý danh mục, banner, sự kiện, thành viên và toàn bộ dữ liệu MĐ.
//  - QL Cụm (MANAGER): Xem & giám sát tổng hợp các Sion / Khu vực được giao.
//  - Ts, nq (SION_LEADER): Xem & giám sát các khu vực và thành viên trong Sion của mình.
//  - Gru (AREA_LEADER): Xem & hỗ trợ cập nhật tiến độ/ghi chú MĐ trong khu vực / Uni mình quản lý.
//  - Uni (UNI_LEADER): Xem & hỗ trợ thành viên thuộc đội (Uni) mình phụ trách.
//  - TĐ (MEMBER): Tự quản lý hồ sơ MĐ của chính mình, nhập báo cáo hằng ngày.
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // Mặc định: chặn tất cả truy cập chưa định nghĩa
    match /{document=**} {
      allow read, write: if false;
    }

    // ---------- Các hàm trợ giúp bảo mật ----------
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function userDocPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function configRolesPath() {
      return /databases/$(database)/documents/system_config/roles;
    }

    // Email Quản trị viên tổng khởi tạo chính thức (khớp regex không phân biệt hoa thường)
    function isSuperAdminEmail(email) {
      return email != null && (
        email == 'cuongtt.tkao@gmail.com' ||
        email == 'hanhchinh.na@gmail.com' ||
        email.matches('(?i)(cuongtt\\.tkao@gmail\\.com|hanhchinh\\.na@gmail\\.com)')
      );
    }

    // Quản trị viên tổng (SUPER_ADMIN)
    function isSuperAdmin() {
      return isSignedIn() && (
        (request.auth.token.email != null && isSuperAdminEmail(request.auth.token.email))
        || (exists(userDocPath()) && get(userDocPath()).data.role == 'SUPER_ADMIN')
        || (
          exists(configRolesPath())
          && request.auth.token.email != null
          && 'superAdmins' in get(configRolesPath()).data
          && get(configRolesPath()).data.superAdmins.hasAny([request.auth.token.email])
        )
      );
    }

    // Ban Quản trị (ADMIN & SUPER_ADMIN)
    function isAdmin() {
      return isSuperAdmin() || (
        isSignedIn() && (
          (exists(userDocPath()) && get(userDocPath()).data.role in ['ADMIN', 'SUPER_ADMIN'])
          || (
            exists(configRolesPath())
            && request.auth.token.email != null
            && 'admins' in get(configRolesPath()).data
            && get(configRolesPath()).data.admins.hasAny([request.auth.token.email])
          )
        )
      );
    }

    // Ts, nq (SION_LEADER)
    function isSionLeader() {
      return isSignedIn()
        && exists(userDocPath())
        && get(userDocPath()).data.role == 'SION_LEADER';
    }

    // Gru (AREA_LEADER)
    function isAreaLeader() {
      return isSignedIn()
        && exists(userDocPath())
        && get(userDocPath()).data.role == 'AREA_LEADER';
    }

    // Uni (UNI_LEADER)
    function isUniLeader() {
      return isSignedIn()
        && exists(userDocPath())
        && get(userDocPath()).data.role == 'UNI_LEADER';
    }

    // QL Cụm (MANAGER)
    function isManager() {
      return isSignedIn()
        && exists(userDocPath())
        && get(userDocPath()).data.role == 'MANAGER';
    }

    // Kiểm tra quyền giám sát theo Sion / Khu vực / Uni đối với hồ sơ MĐ
    function canSupervisorAccessDisciple(data) {
      return (
        isUniLeader()
        && get(userDocPath()).data.companyCode == data.companyCode
        && get(userDocPath()).data.areaCode == data.areaCode
        && ('ownerUnitCode' in data)
        && (
          ('unitCode' in get(userDocPath()).data && data.ownerUnitCode == get(userDocPath()).data.unitCode)
          || ('managedUnitCodes' in get(userDocPath()).data && data.ownerUnitCode in get(userDocPath()).data.managedUnitCodes)
        )
      ) || (
        isAreaLeader()
        && get(userDocPath()).data.areaCode == data.areaCode
        && get(userDocPath()).data.companyCode == data.companyCode
      ) || (
        isSionLeader()
        && (
          get(userDocPath()).data.companyCode == data.companyCode
          || ('managedCompanyCodes' in get(userDocPath()).data && data.companyCode in get(userDocPath()).data.managedCompanyCodes)
        )
      ) || (
        isManager()
        && (
          ('managedAreaCodes' in get(userDocPath()).data && data.areaCode in get(userDocPath()).data.managedAreaCodes)
          || ('managedCompanyCodes' in get(userDocPath()).data && data.companyCode in get(userDocPath()).data.managedCompanyCodes)
        )
      );
    }

    // Kiểm tra cấu trúc hợp lệ của hồ sơ MĐ (chống ghi thừa trường, sai kiểu hoặc quá dung lượng)
    function isValidDisciple(data) {
      return data.keys().hasAll([
          'ownerUid', 'companyCode', 'areaCode', 'nickname',
          'ageMode', 'ageRange', 'progress', 'isStopped', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerUid', 'ownerMemberId', 'ownerName', 'companyCode', 'areaCode', 'ownerUnitCode',
          'nickname', 'ageMode', 'ageRange', 'exactAge', 'job', 'traits',
          'progress', 'isStopped', 'statusNote', 'createdAt', 'updatedAt', 'updatedBy'
        ])
        && data.ownerUid is string && data.ownerUid.size() > 0 && data.ownerUid.size() <= 128
        && (!('ownerMemberId' in data) || (data.ownerMemberId is string && data.ownerMemberId.size() <= 128))
        && (!('ownerName' in data) || (data.ownerName is string && data.ownerName.size() <= 100))
        && data.companyCode is string && data.companyCode.size() <= 30
        && data.areaCode is string && data.areaCode.size() <= 30
        && (!('ownerUnitCode' in data) || (data.ownerUnitCode is string && data.ownerUnitCode.size() <= 50))
        && data.nickname is string && data.nickname.size() > 0 && data.nickname.size() <= 60
        && data.ageMode in ['RANGE', 'EXACT']
        && data.ageRange in ['<18', '18-22', '23-30', '31-45', '>45']
        && (!('exactAge' in data) || data.exactAge == null || (data.exactAge is number && data.exactAge >= 1 && data.exactAge <= 120))
        && (!('job' in data) || (data.job is string && data.job.size() <= 100))
        && (!('traits' in data) || (data.traits is string && data.traits.size() <= 400))
        && data.progress is list
        && data.progress.size() <= 9
        && data.progress.hasOnly(['KN', 'Thăm', 'Ăn Cơm', 'GM', 'ĐT', 'HH', 'KT', 'WS', 'Dừng'])
        && data.isStopped is bool
        && (!('statusNote' in data) || (data.statusNote is string && data.statusNote.size() <= 600))
        && data.createdAt is string && data.createdAt.size() <= 50
        && data.updatedAt is string && data.updatedAt.size() <= 50
        && (!('updatedBy' in data) || (data.updatedBy is string && data.updatedBy.size() <= 100));
    }

    // Kiểm tra quyền giám sát theo Sion / Khu vực / Uni đối với hồ sơ Edu
    function canSupervisorAccessEdu(data) {
      return (
        isUniLeader()
        && get(userDocPath()).data.areaCode == data.areaCode
        && get(userDocPath()).data.companyCode == data.companyCode
      ) || (
        isAreaLeader()
        && get(userDocPath()).data.areaCode == data.areaCode
        && get(userDocPath()).data.companyCode == data.companyCode
      ) || (
        isSionLeader()
        && (
          get(userDocPath()).data.companyCode == data.companyCode
          || ('managedCompanyCodes' in get(userDocPath()).data && data.companyCode in get(userDocPath()).data.managedCompanyCodes)
        )
      ) || (
        isManager()
        && (
          ('managedAreaCodes' in get(userDocPath()).data && data.areaCode in get(userDocPath()).data.managedAreaCodes)
          || ('managedCompanyCodes' in get(userDocPath()).data && data.companyCode in get(userDocPath()).data.managedCompanyCodes)
        )
      );
    }

    function isValidEduTopic(data) {
      return data.keys().hasAll([
          'weekNumber', 'year', 'weekLabel', 'startDate', 'endDate',
          'track', 'companyCode', 'areaCode', 'topicTitle', 'curriculumContent',
          'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'weekNumber', 'year', 'weekLabel', 'startDate', 'endDate',
          'track', 'companyCode', 'areaCode', 'topicTitle', 'summary',
          'learningObjectives', 'curriculumContent', 'referenceLinks',
          'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.weekNumber is number && data.weekNumber >= 1 && data.weekNumber <= 53
        && data.year is number && data.year >= 2020 && data.year <= 2100
        && data.weekLabel is string && data.weekLabel.size() > 0 && data.weekLabel.size() <= 60
        && data.startDate is string && data.startDate.size() <= 15
        && data.endDate is string && data.endDate.size() <= 15
        && data.track in ['TD_I', 'TD_II', 'NGV']
        && data.companyCode is string && data.companyCode.size() <= 30
        && data.areaCode is string && data.areaCode.size() <= 40
        && data.topicTitle is string && data.topicTitle.size() > 0 && data.topicTitle.size() <= 200
        && (!('summary' in data) || (data.summary is string && data.summary.size() <= 1000))
        && (!('learningObjectives' in data) || (data.learningObjectives is string && data.learningObjectives.size() <= 1000))
        && data.curriculumContent is string && data.curriculumContent.size() <= 20000
        && (!('referenceLinks' in data) || (data.referenceLinks is string && data.referenceLinks.size() <= 1000))
        && data.createdBy is string && data.createdBy.size() <= 100
        && data.createdAt is string && data.createdAt.size() <= 50
        && data.updatedAt is string && data.updatedAt.size() <= 50;
    }

    function isValidEduAssignment(data) {
      return data.keys().hasAll([
          'topicId', 'track', 'weekLabel', 'topicTitle', 'companyCode',
          'areaCode', 'studentName', 'assignedByUid', 'assignedByName',
          'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'topicId', 'track', 'weekLabel', 'topicTitle', 'companyCode',
          'areaCode', 'memberId', 'studentName', 'assignedByUid', 'assignedByName',
          'status', 'note', 'createdAt', 'updatedAt'
        ])
        && data.topicId is string && data.topicId.size() > 0 && data.topicId.size() <= 128
        && data.track in ['TD_I', 'TD_II', 'NGV']
        && data.weekLabel is string && data.weekLabel.size() <= 60
        && data.topicTitle is string && data.topicTitle.size() <= 200
        && data.companyCode is string && data.companyCode.size() <= 30
        && data.areaCode is string && data.areaCode.size() > 0 && data.areaCode.size() <= 40
        && (!('memberId' in data) || (data.memberId is string && data.memberId.size() <= 128))
        && data.studentName is string && data.studentName.size() > 0 && data.studentName.size() <= 120
        && data.assignedByUid is string && data.assignedByUid.size() > 0 && data.assignedByUid.size() <= 128
        && data.assignedByName is string && data.assignedByName.size() <= 100
        && data.status in ['REGISTERED', 'IN_PROGRESS', 'COMPLETED']
        && (!('note' in data) || (data.note is string && data.note.size() <= 500))
        && data.createdAt is string && data.createdAt.size() <= 50
        && data.updatedAt is string && data.updatedAt.size() <= 50;
    }

    function isValidEduCmsProfile(data) {
      return data.keys().hasAll([
          'fullName', 'companyCode', 'areaCode', 'stage', 'ngvName',
          'ownerUid', 'updatedBy', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'fullName', 'companyCode', 'areaCode', 'stage', 'ngvName',
          'specialty', 'currentTopicId', 'currentTopicTitle', 'note',
          'ownerUid', 'updatedBy', 'createdAt', 'updatedAt'
        ])
        && data.fullName is string && data.fullName.size() > 0 && data.fullName.size() <= 120
        && data.companyCode is string && data.companyCode.size() <= 30
        && data.areaCode is string && data.areaCode.size() <= 40
        && data.stage in ['TD_MOI', 'TD_I', 'TD_II', 'NGV']
        && data.ngvName is string && data.ngvName.size() <= 120
        && (!('specialty' in data) || (data.specialty is string && data.specialty.size() <= 200))
        && (!('currentTopicId' in data) || (data.currentTopicId is string && data.currentTopicId.size() <= 128))
        && (!('currentTopicTitle' in data) || (data.currentTopicTitle is string && data.currentTopicTitle.size() <= 200))
        && (!('note' in data) || (data.note is string && data.note.size() <= 600))
        && data.ownerUid is string && data.ownerUid.size() > 0 && data.ownerUid.size() <= 128
        && data.updatedBy is string && data.updatedBy.size() <= 100
        && data.createdAt is string && data.createdAt.size() <= 50
        && data.updatedAt is string && data.updatedAt.size() <= 50;
    }

    // Mã thành viên của chính người dùng đang đăng nhập
    function ownMemberId() {
      return 'm-' + request.auth.uid;
    }

    // ---------- Cấu hình hệ thống (roles, banner, scoring, appearance) ----------
    match /system_config/{id} {
      allow read: if id in ['banner', 'scoring', 'appearance'] || isSignedIn();
      allow write: if (id in ['banner', 'scoring', 'appearance'] && isAdmin()) || isSuperAdmin();
    }

    // ---------- Sự kiện & Chiến dịch thi đua (events/{id}) ----------
    match /events/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------- Edu LMS: Chủ đề theo tuần & Giáo trình bài học (edu_topics/{topicId}) ----------
    match /edu_topics/{topicId} {
      allow read: if isSignedIn();
      allow create, update: if isValidId(topicId)
        && isAdmin()
        && isValidEduTopic(request.resource.data);
      allow delete: if isValidId(topicId) && isAdmin();
    }

    // ---------- Edu LMS: Gán Tên KV & Tên TĐ vào Chủ đề tuần (edu_assignments/{assignmentId}) ----------
    match /edu_assignments/{assignmentId} {
      allow read: if isSignedIn();
      allow create: if isValidId(assignmentId)
        && isSignedIn()
        && isValidEduAssignment(request.resource.data)
        && (request.resource.data.assignedByUid == request.auth.uid || isAdmin());
      allow update: if isValidId(assignmentId)
        && isSignedIn()
        && isValidEduAssignment(request.resource.data)
        && request.resource.data.assignedByUid == resource.data.assignedByUid
        && (
          isAdmin()
          || resource.data.assignedByUid == request.auth.uid
          || canSupervisorAccessEdu(resource.data)
        );
      allow delete: if isValidId(assignmentId)
        && isSignedIn()
        && (
          isAdmin()
          || resource.data.assignedByUid == request.auth.uid
          || canSupervisorAccessEdu(resource.data)
        );
    }

    // ---------- Edu CMS: Quản lý lộ trình TĐ Mới -> TĐ-II & danh sách NGV (edu_cms_profiles/{profileId}) ----------
    match /edu_cms_profiles/{profileId} {
      allow read: if isSignedIn();
      allow create: if isValidId(profileId)
        && isSignedIn()
        && isValidEduCmsProfile(request.resource.data)
        && (
          isAdmin()
          || request.resource.data.ownerUid == request.auth.uid
          || isUniLeader()
          || isAreaLeader()
          || isSionLeader()
          || isManager()
        );
      allow update: if isValidId(profileId)
        && isSignedIn()
        && isValidEduCmsProfile(request.resource.data)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && (
          isAdmin()
          || resource.data.ownerUid == request.auth.uid
          || canSupervisorAccessEdu(resource.data)
        );
      allow delete: if isValidId(profileId)
        && isSignedIn()
        && (
          isAdmin()
          || resource.data.ownerUid == request.auth.uid
          || canSupervisorAccessEdu(resource.data)
        );
    }

    // ---------- Trang thông tin MĐ (disciples/{discipleId}) ----------
    match /disciples/{discipleId} {
      allow get: if isValidId(discipleId) && isSignedIn() && (
        isAdmin()
        || resource.data.ownerUid == request.auth.uid
        || canSupervisorAccessDisciple(resource.data)
      );

      allow list: if isSignedIn() && (
        isAdmin()
        || resource.data.ownerUid == request.auth.uid
        || canSupervisorAccessDisciple(resource.data)
      );

      allow create: if isValidId(discipleId)
        && isSignedIn()
        && isValidDisciple(request.resource.data)
        && (request.resource.data.ownerUid == request.auth.uid || isAdmin());

      allow update: if isValidId(discipleId)
        && isSignedIn()
        && isValidDisciple(request.resource.data)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.createdAt == resource.data.createdAt
        && (
          isAdmin()
          || resource.data.ownerUid == request.auth.uid
          || (
            canSupervisorAccessDisciple(resource.data)
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['progress', 'isStopped', 'statusNote', 'updatedAt', 'updatedBy'])
          )
        );

      allow delete: if isValidId(discipleId) && isSignedIn() && (
        isAdmin() || resource.data.ownerUid == request.auth.uid
      );
    }

    // ---------- Báo cáo hằng ngày (dailyReports/{id}) ----------
    match /dailyReports/{id} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && (
        isAdmin() || request.resource.data.uid == request.auth.uid
      );
      allow delete: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
    }

    // ---------- Mục tiêu Tháng / Năm (periodGoals/{id}) ----------
    match /periodGoals/{id} {
      allow get: if isSignedIn() && (
        isAdmin()
        || id.matches('^' + request.auth.uid + '_.*')
        || resource.data.uid == request.auth.uid
      );
      allow list: if isSignedIn() && (
        isAdmin()
        || resource.data.uid == request.auth.uid
      );
      allow create, update: if isSignedIn() && (
        isAdmin() || request.resource.data.uid == request.auth.uid
      );
      allow delete: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
    }

    // ---------- users/{uid}: hồ sơ tài khoản & phân quyền 7 cấp ----------
    match /users/{uid} {
      allow get: if isSignedIn();
      allow list: if isAdmin();

      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() > 0
        && request.resource.data.fullName.size() <= 100
        && (
          (request.resource.data.role == 'MEMBER') ||
          (request.resource.data.role in ['ADMIN', 'SUPER_ADMIN', 'MANAGER', 'SION_LEADER', 'AREA_LEADER', 'UNI_LEADER'] && (isSuperAdmin() || isSuperAdminEmail(request.auth.token.email)))
        );

      allow update: if isSignedIn() && (
        isSuperAdmin()
        || isSuperAdminEmail(request.auth.token.email)
        || (
          isAdmin()
          && request.resource.data.role != 'SUPER_ADMIN'
          && resource.data.role != 'SUPER_ADMIN'
        )
        || (
          request.auth.uid == uid
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['managedCompanyCodes', 'managedAreaCodes', 'managedUnitCodes'])
          && (
            request.resource.data.role == resource.data.role
            || (request.resource.data.role == 'SUPER_ADMIN' && isSuperAdminEmail(request.auth.token.email))
          )
        )
      );

      allow delete: if isSuperAdmin() || isSuperAdminEmail(request.auth.token.email);
    }

    // ---------- Danh mục: công ty, khu vực, ban ngành ----------
    match /companies/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /areas/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /departments/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------- members/{id}: thành viên & điểm số thi đua ----------
    match /members/{id} {
      allow read: if true;

      allow create: if isSignedIn() && (
        isAdmin() ||
        id == ownMemberId() ||
        (request.resource.data.id is string && request.resource.data.id == id)
      );

      allow update: if isSignedIn() && (
        isAdmin() ||
        id == ownMemberId() ||
        (resource.data.id is string && request.resource.data.id == resource.data.id)
      );

      allow delete: if isAdmin();
    }

    // ---------- targets/{id}: nhật ký đối tượng chi tiết (legacy) ----------
    match /targets/{id} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if isAdmin() || (isSignedIn() && resource.data.memberId == ownMemberId());
    }

    // ---------- huongKhi/{id}: bài chia sẻ hương khí & lời chứng ----------
    match /huongKhi/{id} {
      allow read: if true;

      allow create: if isSignedIn()
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 300
        && request.resource.data.content is string;

      allow update: if isSignedIn() && (
        isAdmin()
        || resource.data.authorId == ownMemberId()
        || request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['reactions', 'likesCount', 'userReaction', 'comments', 'userReactions'])
      );

      allow delete: if isAdmin() || (isSignedIn() && resource.data.authorId == ownMemberId());
    }
  }
}
