rules_version = '2';

// ============================================================
//  Hành Thực Lục - Quy tắc bảo mật Firestore (7 cấp phân quyền)
//  - Admin Tổng / HT (SUPER_ADMIN - Cấp 7): Toàn quyền cấu hình, phân quyền tất cả các cấp.
//  - Ban Quản Trị HT (ADMIN - Cấp 6): Quản trị hệ thống, đổi/đặt lại PIN, duyệt ĐK & phân quyền cấp 5 trở xuống.
//  - QL Cụm (MANAGER - Cấp 5): Tổ chức & Nhân sự trong cụm, phân quyền cấp 4 trở xuống.
//  - TS, NQ (SION_LEADER - Cấp 4): Tổ chức & Nhân sự trong Sion, phân quyền cấp 3 trở xuống.
//  - Gru (AREA_LEADER - Cấp 3): Tổ chức & Nhân sự trong khu vực, phân quyền cấp 2 trở xuống.
//  - Uni (UNI_LEADER - Cấp 2): Tổ chức & Nhân sự trong đội Uni, phân quyền cấp 1 trở xuống.
//  - TĐ (MEMBER - Cấp 1): Tự quản lý hồ sơ MĐ của chính mình, nhập báo cáo hằng ngày.
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // Mặc định: chặn tất cả truy cập chưa định nghĩa
    match /{document=**} {
      allow read, write: if false;
    }

    // ---------- Các hàm trợ giúp bảo mật ----------
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_-]+$');
    }

    function userDocPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function configRolesPath() {
      return /databases/$(database)/documents/system_config/roles;
    }

    function hasOwnRoleClaim() {
      return isSignedIn()
        && request.auth.token.email != null
        && request.auth.token.email.size() > 0
        && exists(/databases/$(database)/documents/role_claims/$(request.auth.token.email.lower()));
    }

    function ownRoleClaimData() {
      return get(/databases/$(database)/documents/role_claims/$(request.auth.token.email.lower())).data;
    }

    // Email Quản trị viên tổng khởi tạo chính thức (khớp regex không phân biệt hoa thường)
    function isSuperAdminEmail(email) {
      return email != null && (
        email == 'cuongtt.tkao@gmail.com' ||
        email == 'hanhchinh.na@gmail.com' ||
        email.matches('(?i)(cuongtt\\.tkao@gmail\\.com|hanhchinh\\.na@gmail\\.com)')
      );
    }

    // Quản trị viên tổng (SUPER_ADMIN)
    function isSuperAdmin() {
      return isSignedIn() && (
        (request.auth.token.email != null && isSuperAdminEmail(request.auth.token.email))
        || (exists(userDocPath()) && get(userDocPath()).data.role == 'SUPER_ADMIN')
        || (hasOwnRoleClaim() && ownRoleClaimData().role == 'SUPER_ADMIN')
        || (
          exists(configRolesPath())
          && request.auth.token.email != null
          && 'superAdmins' in get(configRolesPath()).data
          && get(configRolesPath()).data.superAdmins.hasAny([request.auth.token.email])
        )
      );
    }

    // Ban Quản trị (ADMIN & SUPER_ADMIN)
    function isAdmin() {
      return isSuperAdmin() || (
        isSignedIn() && (
          (exists(userDocPath()) && get(userDocPath()).data.role in ['ADMIN', 'SUPER_ADMIN'])
          || (hasOwnRoleClaim() && ownRoleClaimData().role in ['ADMIN', 'SUPER_ADMIN'])
          || (
            exists(configRolesPath())
            && request.auth.token.email != null
            && 'admins' in get(configRolesPath()).data
            && get(configRolesPath()).data.admins.hasAny([request.auth.token.email])
          )
        )
      );
    }

    // Ts, nq (SION_LEADER)
    function isSionLeader() {
      return isSignedIn()
        && exists(userDocPath())
        && get(userDocPath()).data.role == 'SION_LEADER';
    }

    // Gru (AREA_LEADER)
    function isAreaLeader() {
      return isSignedIn()
        && exists(userDocPath())
        && get(userDocPath()).data.role == 'AREA_LEADER';
    }

    // Uni (UNI_LEADER)
    function isUniLeader() {
      return isSignedIn()
        && exists(userDocPath())
        && get(userDocPath()).data.role == 'UNI_LEADER';
    }

    // QL Cụm (MANAGER)
    function isManager() {
      return isSignedIn()
        && exists(userDocPath())
        && get(userDocPath()).data.role == 'MANAGER';
    }

    function roleLevel(role) {
      return role == 'SUPER_ADMIN' ? 7
        : role == 'ADMIN' ? 6
        : role == 'MANAGER' ? 5
        : role == 'SION_LEADER' ? 4
        : role == 'AREA_LEADER' ? 3
        : role == 'UNI_LEADER' ? 2
        : 1;
    }

    function actorRoleLevel() {
      return isSuperAdmin() ? 7
        : isAdmin() ? 6
        : isManager() ? 5
        : isSionLeader() ? 4
        : isAreaLeader() ? 3
        : isUniLeader() ? 2
        : 1;
    }

    function matchesUniUnit(viewerData, targetData) {
      return (
        ('unitCode' in targetData && targetData.unitCode is string && targetData.unitCode.size() > 0)
          ? (
              ('unitCode' in viewerData && targetData.unitCode == viewerData.unitCode)
              || ('managedUnitCodes' in viewerData && targetData.unitCode in viewerData.managedUnitCodes)
            )
          : (
              ('departmentCode' in targetData && targetData.departmentCode is string) && (
                ('unitCode' in viewerData && viewerData.unitCode is string && viewerData.unitCode.size() > 0 && targetData.departmentCode == viewerData.unitCode)
                || ('managedUnitCodes' in viewerData && viewerData.managedUnitCodes.size() > 0 && targetData.departmentCode in viewerData.managedUnitCodes)
                || (
                  (!('unitCode' in viewerData) || !(viewerData.unitCode is string) || viewerData.unitCode.size() == 0)
                  && (!('managedUnitCodes' in viewerData) || viewerData.managedUnitCodes.size() == 0)
                  && ('departmentCode' in viewerData && targetData.departmentCode == viewerData.departmentCode)
                )
              )
            )
      );
    }

    // Kiểm tra phạm vi quản lý Tổ chức & Nhân sự (Users / Members) của Cấp 2 -> 5
    function canSupervisorAccessOrg(data) {
      return ('companyCode' in data) && ('areaCode' in data) && (
        (
          isUniLeader()
          && get(userDocPath()).data.companyCode == data.companyCode
          && get(userDocPath()).data.areaCode == data.areaCode
          && matchesUniUnit(get(userDocPath()).data, data)
        ) || (
          isAreaLeader()
          && (
            get(userDocPath()).data.areaCode == data.areaCode
            || ('managedAreaCodes' in get(userDocPath()).data && data.areaCode in get(userDocPath()).data.managedAreaCodes)
          )
          && (
            get(userDocPath()).data.companyCode == data.companyCode
            || ('managedCompanyCodes' in get(userDocPath()).data && data.companyCode in get(userDocPath()).data.managedCompanyCodes)
          )
        ) || (
          isSionLeader()
          && (
            get(userDocPath()).data.companyCode == data.companyCode
            || ('managedCompanyCodes' in get(userDocPath()).data && data.companyCode in get(userDocPath()).data.managedCompanyCodes)
          )
        ) || (
          isManager()
          && (
            get(userDocPath()).data.companyCode == data.companyCode
            || ('managedCompanyCodes' in get(userDocPath()).data && data.companyCode in get(userDocPath()).data.managedCompanyCodes)
            || ('managedAreaCodes' in get(userDocPath()).data && data.areaCode in get(userDocPath()).data.managedAreaCodes)
          )
        )
      );
    }

    // Kiểm tra quyền giám sát theo Sion / Khu vực / Uni đối với hồ sơ MĐ & Lịch làm việc
    function canSupervisorAccessDisciple(data) {
      return (
        isUniLeader()
        && get(userDocPath()).data.companyCode == data.companyCode
        && get(userDocPath()).data.areaCode == data.areaCode
        && ('ownerUnitCode' in data)
        && (
          ('unitCode' in get(userDocPath()).data && data.ownerUnitCode == get(userDocPath()).data.unitCode)
          || ('managedUnitCodes' in get(userDocPath()).data && data.ownerUnitCode in get(userDocPath()).data.managedUnitCodes)
        )
      ) || (
        isAreaLeader()
        && (
          get(userDocPath()).data.areaCode == data.areaCode
          || ('managedAreaCodes' in get(userDocPath()).data && data.areaCode in get(userDocPath()).data.managedAreaCodes)
        )
        && (
          get(userDocPath()).data.companyCode == data.companyCode
          || ('managedCompanyCodes' in get(userDocPath()).data && data.companyCode in get(userDocPath()).data.managedCompanyCodes)
        )
      ) || (
        isSionLeader()
        && (
          get(userDocPath()).data.companyCode == data.companyCode
          || ('managedCompanyCodes' in get(userDocPath()).data && data.companyCode in get(userDocPath()).data.managedCompanyCodes)
        )
      ) || (
        isManager()
        && (
          ('managedAreaCodes' in get(userDocPath()).data && data.areaCode in get(userDocPath()).data.managedAreaCodes)
          || ('managedCompanyCodes' in get(userDocPath()).data && data.companyCode in get(userDocPath()).data.managedCompanyCodes)
        )
      );
    }

    // Kiểm tra cấu trúc hợp lệ của hồ sơ MĐ (chống ghi thừa trường, sai kiểu hoặc quá dung lượng)
    function isValidDisciple(data) {
      return data.keys().hasAll([
          'ownerUid', 'companyCode', 'areaCode', 'nickname',
          'ageMode', 'ageRange', 'progress', 'isStopped', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerUid', 'ownerMemberId', 'ownerName', 'companyCode', 'areaCode', 'ownerUnitCode',
          'nickname', 'ageMode', 'ageRange', 'exactAge', 'job', 'traits',
          'progress', 'isStopped', 'statusNote', 'createdAt', 'updatedAt', 'updatedBy'
        ])
        && data.ownerUid is string && data.ownerUid.size() > 0 && data.ownerUid.size() <= 128
        && (!('ownerMemberId' in data) || (data.ownerMemberId is string && data.ownerMemberId.size() <= 128))
        && (!('ownerName' in data) || (data.ownerName is string && data.ownerName.size() <= 100))
        && data.companyCode is string && data.companyCode.size() <= 30
        && data.areaCode is string && data.areaCode.size() <= 30
        && (!('ownerUnitCode' in data) || (data.ownerUnitCode is string && data.ownerUnitCode.size() <= 50))
        && data.nickname is string && data.nickname.size() > 0 && data.nickname.size() <= 60
        && data.ageMode in ['RANGE', 'EXACT']
        && data.ageRange in ['<18', '18-22', '23-30', '31-45', '>45']
        && (!('exactAge' in data) || data.exactAge == null || (data.exactAge is number && data.exactAge >= 1 && data.exactAge <= 120))
        && (!('job' in data) || (data.job is string && data.job.size() <= 100))
        && (!('traits' in data) || (data.traits is string && data.traits.size() <= 400))
        && data.progress is list
        && data.progress.size() <= 9
        && data.progress.hasOnly(['KN', 'Thăm', 'Ăn Cơm', 'GM', 'ĐT', 'HH', 'KT', 'WS', 'Dừng'])
        && data.isStopped is bool
        && (!('statusNote' in data) || (data.statusNote is string && data.statusNote.size() <= 600))
        && data.createdAt is string && data.createdAt.size() <= 50
        && data.updatedAt is string && data.updatedAt.size() <= 50
        && (!('updatedBy' in data) || (data.updatedBy is string && data.updatedBy.size() <= 100));
    }

    // Kiểm tra quyền giám sát theo Sion / Khu vực / Uni đối với hồ sơ Edu
    function canSupervisorAccessEdu(data) {
      return (
        isUniLeader()
        && get(userDocPath()).data.areaCode == data.areaCode
        && get(userDocPath()).data.companyCode == data.companyCode
      ) || (
        isAreaLeader()
        && (
          get(userDocPath()).data.areaCode == data.areaCode
          || ('managedAreaCodes' in get(userDocPath()).data && data.areaCode in get(userDocPath()).data.managedAreaCodes)
        )
        && (
          get(userDocPath()).data.companyCode == data.companyCode
          || ('managedCompanyCodes' in get(userDocPath()).data && data.companyCode in get(userDocPath()).data.managedCompanyCodes)
        )
      ) || (
        isSionLeader()
        && (
          get(userDocPath()).data.companyCode == data.companyCode
          || ('managedCompanyCodes' in get(userDocPath()).data && data.companyCode in get(userDocPath()).data.managedCompanyCodes)
        )
      ) || (
        isManager()
        && (
          ('managedAreaCodes' in get(userDocPath()).data && data.areaCode in get(userDocPath()).data.managedAreaCodes)
          || ('managedCompanyCodes' in get(userDocPath()).data && data.companyCode in get(userDocPath()).data.managedCompanyCodes)
        )
      );
    }

    // Kiểm tra quyền giám sát đối với Báo cáo hằng ngày
    function canSupervisorAccessDailyReport(data) {
      return (
        isUniLeader()
        && get(userDocPath()).data.companyCode == data.companyCode
        && get(userDocPath()).data.areaCode == data.areaCode
        && ('unitCode' in data)
        && (
          ('unitCode' in get(userDocPath()).data && data.unitCode == get(userDocPath()).data.unitCode)
          || ('managedUnitCodes' in get(userDocPath()).data && data.unitCode in get(userDocPath()).data.managedUnitCodes)
        )
      ) || (
        isAreaLeader()
        && (
          get(userDocPath()).data.areaCode == data.areaCode
          || ('managedAreaCodes' in get(userDocPath()).data && data.areaCode in get(userDocPath()).data.managedAreaCodes)
        )
        && (
          get(userDocPath()).data.companyCode == data.companyCode
          || ('managedCompanyCodes' in get(userDocPath()).data && data.companyCode in get(userDocPath()).data.managedCompanyCodes)
        )
      ) || (
        isSionLeader()
        && (
          get(userDocPath()).data.companyCode == data.companyCode
          || ('managedCompanyCodes' in get(userDocPath()).data && data.companyCode in get(userDocPath()).data.managedCompanyCodes)
        )
      ) || (
        isManager()
        && (
          ('managedAreaCodes' in get(userDocPath()).data && data.areaCode in get(userDocPath()).data.managedAreaCodes)
          || ('managedCompanyCodes' in get(userDocPath()).data && data.companyCode in get(userDocPath()).data.managedCompanyCodes)
        )
      );
    }

    function isValidDailyReport(data) {
      return data.keys().hasAll(['uid', 'date', 'month', 'year', 'goals', 'results'])
        && data.keys().hasOnly([
          'uid', 'memberId', 'companyCode', 'areaCode', 'unitCode',
          'date', 'month', 'year', 'goals', 'results', 'updatedAt'
        ])
        && data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128
        && (!('memberId' in data) || (data.memberId is string && data.memberId.size() <= 128))
        && (!('companyCode' in data) || (data.companyCode is string && data.companyCode.size() <= 30))
        && (!('areaCode' in data) || (data.areaCode is string && data.areaCode.size() <= 30))
        && (!('unitCode' in data) || (data.unitCode is string && data.unitCode.size() <= 50))
        && data.date is string && data.date.size() <= 15
        && data.month is string && data.month.size() <= 10
        && data.year is string && data.year.size() <= 6
        && data.goals is map
        && data.results is map;
    }

    function isValidEduTopic(data) {
      return data.keys().hasAll([
          'weekNumber', 'year', 'weekLabel', 'startDate', 'endDate',
          'track', 'companyCode', 'areaCode', 'topicTitle', 'curriculumContent',
          'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'weekNumber', 'year', 'weekLabel', 'startDate', 'endDate',
          'track', 'companyCode', 'areaCode', 'topicTitle', 'summary',
          'learningObjectives', 'curriculumContent', 'referenceLinks',
          'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.weekNumber is number && data.weekNumber >= 1 && data.weekNumber <= 53
        && data.year is number && data.year >= 2020 && data.year <= 2100
        && data.weekLabel is string && data.weekLabel.size() > 0 && data.weekLabel.size() <= 60
        && data.startDate is string && data.startDate.size() <= 15
        && data.endDate is string && data.endDate.size() <= 15
        && data.track in ['TD_I', 'TD_II', 'NGV']
        && data.companyCode is string && data.companyCode.size() <= 30
        && data.areaCode is string && data.areaCode.size() <= 40
        && data.topicTitle is string && data.topicTitle.size() > 0 && data.topicTitle.size() <= 200
        && (!('summary' in data) || (data.summary is string && data.summary.size() <= 1000))
        && (!('learningObjectives' in data) || (data.learningObjectives is string && data.learningObjectives.size() <= 1000))
        && data.curriculumContent is string && data.curriculumContent.size() <= 20000
        && (!('referenceLinks' in data) || (data.referenceLinks is string && data.referenceLinks.size() <= 1000))
        && data.createdBy is string && data.createdBy.size() <= 100
        && data.createdAt is string && data.createdAt.size() <= 50
        && data.updatedAt is string && data.updatedAt.size() <= 50;
    }

    function isValidEduAssignment(data) {
      return data.keys().hasAll([
          'topicId', 'track', 'weekLabel', 'topicTitle', 'companyCode',
          'areaCode', 'studentName', 'assignedByUid', 'assignedByName',
          'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'topicId', 'track', 'weekLabel', 'topicTitle', 'companyCode',
          'areaCode', 'memberId', 'studentName', 'assignedByUid', 'assignedByName',
          'status', 'note', 'createdAt', 'updatedAt'
        ])
        && data.topicId is string && data.topicId.size() > 0 && data.topicId.size() <= 128
        && data.track in ['TD_I', 'TD_II', 'NGV']
        && data.weekLabel is string && data.weekLabel.size() <= 60
        && data.topicTitle is string && data.topicTitle.size() <= 200
        && data.companyCode is string && data.companyCode.size() <= 30
        && data.areaCode is string && data.areaCode.size() > 0 && data.areaCode.size() <= 40
        && (!('memberId' in data) || (data.memberId is string && data.memberId.size() <= 128))
        && data.studentName is string && data.studentName.size() > 0 && data.studentName.size() <= 120
        && data.assignedByUid is string && data.assignedByUid.size() > 0 && data.assignedByUid.size() <= 128
        && data.assignedByName is string && data.assignedByName.size() <= 100
        && data.status in ['REGISTERED', 'IN_PROGRESS', 'COMPLETED']
        && (!('note' in data) || (data.note is string && data.note.size() <= 500))
        && data.createdAt is string && data.createdAt.size() <= 50
        && data.updatedAt is string && data.updatedAt.size() <= 50;
    }

    function isValidEduCmsProfile(data) {
      return data.keys().hasAll([
          'fullName', 'companyCode', 'areaCode', 'stage', 'ngvName',
          'ownerUid', 'updatedBy', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'fullName', 'companyCode', 'areaCode', 'stage', 'ngvName',
          'specialty', 'currentTopicId', 'currentTopicTitle', 'note',
          'ownerUid', 'updatedBy', 'createdAt', 'updatedAt'
        ])
        && data.fullName is string && data.fullName.size() > 0 && data.fullName.size() <= 120
        && data.companyCode is string && data.companyCode.size() <= 30
        && data.areaCode is string && data.areaCode.size() <= 40
        && data.stage in ['TD_MOI', 'TD_I', 'TD_II', 'NGV']
        && data.ngvName is string && data.ngvName.size() <= 120
        && (!('specialty' in data) || (data.specialty is string && data.specialty.size() <= 200))
        && (!('currentTopicId' in data) || (data.currentTopicId is string && data.currentTopicId.size() <= 128))
        && (!('currentTopicTitle' in data) || (data.currentTopicTitle is string && data.currentTopicTitle.size() <= 200))
        && (!('note' in data) || (data.note is string && data.note.size() <= 600))
        && data.ownerUid is string && data.ownerUid.size() > 0 && data.ownerUid.size() <= 128
        && data.updatedBy is string && data.updatedBy.size() <= 100
        && data.createdAt is string && data.createdAt.size() <= 50
        && data.updatedAt is string && data.updatedAt.size() <= 50;
    }

    function isValidWorkSchedule(data) {
      return data.keys().hasAll([
          'ownerUid', 'ownerName', 'companyCode', 'areaCode',
          'weekStart', 'weekEnd', 'sessions', 'wsActiveDays', 'ws',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerUid', 'ownerMemberId', 'ownerName', 'companyCode', 'areaCode', 'ownerUnitCode',
          'weekStart', 'weekEnd', 'sessions', 'wsActiveDays', 'ws', 'noteLegend',
          'createdAt', 'updatedAt'
        ])
        && data.ownerUid is string && data.ownerUid.size() > 0 && data.ownerUid.size() <= 128
        && (!('ownerMemberId' in data) || (data.ownerMemberId is string && data.ownerMemberId.size() <= 128))
        && data.ownerName is string && data.ownerName.size() > 0 && data.ownerName.size() <= 100
        && data.companyCode is string && data.companyCode.size() <= 30
        && data.areaCode is string && data.areaCode.size() <= 30
        && (!('ownerUnitCode' in data) || (data.ownerUnitCode is string && data.ownerUnitCode.size() <= 50))
        && data.weekStart is string && data.weekStart.size() >= 8 && data.weekStart.size() <= 15
        && data.weekEnd is string && data.weekEnd.size() >= 8 && data.weekEnd.size() <= 15
        && data.sessions is map
        && data.sessions.keys().hasOnly(['sun', 'mon', 'tue', 'wed', 'thu', 'fri', 'sat'])
        && data.wsActiveDays is list
        && data.wsActiveDays.size() <= 7
        && data.wsActiveDays.hasOnly(['sun', 'mon', 'tue', 'wed', 'thu', 'fri', 'sat'])
        && data.ws is map
        && data.ws.keys().hasOnly(['sun', 'mon', 'tue', 'wed', 'thu', 'fri', 'sat'])
        && (!('noteLegend' in data) || (data.noteLegend is string && data.noteLegend.size() <= 600))
        && data.createdAt is string && data.createdAt.size() <= 50
        && data.updatedAt is string && data.updatedAt.size() <= 50;
    }

    // Mã thành viên của chính người dùng đang đăng nhập
    function ownMemberId() {
      return 'm-' + request.auth.uid;
    }

    function securityConfigPath() {
      return /databases/$(database)/documents/system_config/security;
    }

    function isApprovalRequired() {
      return !exists(securityConfigPath())
        || !('requireRegistrationApproval' in get(securityConfigPath()).data)
        || get(securityConfigPath()).data.requireRegistrationApproval == true;
    }

    function isAutoApprovePreAssignedEnabled() {
      return !exists(securityConfigPath())
        || !('autoApprovePreAssigned' in get(securityConfigPath()).data)
        || get(securityConfigPath()).data.autoApprovePreAssigned == true;
    }

    // Chỉ tài khoản đã được duyệt (hoặc tài khoản cũ chưa có trường approvalStatus, hoặc Admin/SuperAdmin) mới được đọc/ghi dữ liệu
    function isApprovedUser() {
      return isAdmin() || (
        isSignedIn()
        && exists(userDocPath())
        && (
          !('approvalStatus' in get(userDocPath()).data)
          || get(userDocPath()).data.approvalStatus == 'APPROVED'
        )
      );
    }

    // ---------- Cấu hình hệ thống (roles chỉ dành cho Admin; banner, scoring, appearance, security công khai đọc) ----------
    match /system_config/{id} {
      allow read: if id in ['banner', 'scoring', 'appearance', 'security'] || isAdmin();
      allow write: if (id in ['banner', 'scoring', 'appearance', 'security'] && isAdmin()) || isSuperAdmin();
    }

    // ---------- role_claims/{email}: Quyền được cấp trước riêng cho từng email ----------
    match /role_claims/{email} {
      allow get: if isSignedIn() && (
        isAdmin()
        || (request.auth.token.email != null && request.auth.token.email.lower() == email)
      );
      allow list, create, update, delete: if isSuperAdmin();
    }

    // ---------- Sự kiện & Chiến dịch thi đua (events/{id}) ----------
    match /events/{id} {
      allow read: if isApprovedUser();
      allow write: if isAdmin();
    }

    // ---------- Edu LMS: Chủ đề theo tuần & Giáo trình bài học (edu_topics/{topicId}) ----------
    match /edu_topics/{topicId} {
      allow read: if isApprovedUser();
      allow create, update: if isValidId(topicId)
        && isAdmin()
        && isValidEduTopic(request.resource.data);
      allow delete: if isValidId(topicId) && isAdmin();
    }

    // ---------- Edu LMS: Gán Tên KV & Tên TĐ vào Chủ đề tuần (edu_assignments/{assignmentId}) ----------
    match /edu_assignments/{assignmentId} {
      allow read: if isApprovedUser() && (
        isAdmin()
        || resource.data.assignedByUid == request.auth.uid
        || ('memberId' in resource.data && resource.data.memberId == ownMemberId())
        || canSupervisorAccessEdu(resource.data)
      );
      allow create: if isValidId(assignmentId)
        && isApprovedUser()
        && isValidEduAssignment(request.resource.data)
        && (request.resource.data.assignedByUid == request.auth.uid || isAdmin());
      allow update: if isValidId(assignmentId)
        && isApprovedUser()
        && isValidEduAssignment(request.resource.data)
        && request.resource.data.assignedByUid == resource.data.assignedByUid
        && (
          isAdmin()
          || resource.data.assignedByUid == request.auth.uid
          || canSupervisorAccessEdu(resource.data)
        );
      allow delete: if isValidId(assignmentId)
        && isApprovedUser()
        && (
          isAdmin()
          || resource.data.assignedByUid == request.auth.uid
          || canSupervisorAccessEdu(resource.data)
        );
    }

    // ---------- Edu CMS: Quản lý lộ trình TĐ Mới -> TĐ-II & danh sách NGV (edu_cms_profiles/{profileId}) ----------
    match /edu_cms_profiles/{profileId} {
      allow read: if isApprovedUser() && (
        isAdmin()
        || resource.data.ownerUid == request.auth.uid
        || canSupervisorAccessEdu(resource.data)
      );
      allow create: if isValidId(profileId)
        && isApprovedUser()
        && isValidEduCmsProfile(request.resource.data)
        && (
          isAdmin()
          || request.resource.data.ownerUid == request.auth.uid
          || isUniLeader()
          || isAreaLeader()
          || isSionLeader()
          || isManager()
        );
      allow update: if isValidId(profileId)
        && isApprovedUser()
        && isValidEduCmsProfile(request.resource.data)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && (
          isAdmin()
          || resource.data.ownerUid == request.auth.uid
          || canSupervisorAccessEdu(resource.data)
        );
      allow delete: if isValidId(profileId)
        && isApprovedUser()
        && (
          isAdmin()
          || resource.data.ownerUid == request.auth.uid
          || canSupervisorAccessEdu(resource.data)
        );
    }

    // ---------- Trang thông tin MĐ (disciples/{discipleId}) ----------
    match /disciples/{discipleId} {
      allow get: if isValidId(discipleId) && isApprovedUser() && (
        isAdmin()
        || resource.data.ownerUid == request.auth.uid
        || canSupervisorAccessDisciple(resource.data)
      );

      allow list: if isApprovedUser() && (
        isAdmin()
        || resource.data.ownerUid == request.auth.uid
        || canSupervisorAccessDisciple(resource.data)
      );

      allow create: if isValidId(discipleId)
        && isApprovedUser()
        && isValidDisciple(request.resource.data)
        && (request.resource.data.ownerUid == request.auth.uid || isAdmin());

      allow update: if isValidId(discipleId)
        && isApprovedUser()
        && isValidDisciple(request.resource.data)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.createdAt == resource.data.createdAt
        && (
          isAdmin()
          || resource.data.ownerUid == request.auth.uid
          || (
            canSupervisorAccessDisciple(resource.data)
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['progress', 'isStopped', 'statusNote', 'updatedAt', 'updatedBy'])
          )
        );

      allow delete: if isValidId(discipleId) && isApprovedUser() && (
        isAdmin() || resource.data.ownerUid == request.auth.uid
      );
    }

    // ---------- Lịch làm việc tuần (work_schedules/{scheduleId}) ----------
    match /work_schedules/{scheduleId} {
      allow get: if isValidId(scheduleId) && isApprovedUser() && (
        isAdmin()
        || resource.data.ownerUid == request.auth.uid
        || canSupervisorAccessDisciple(resource.data)
      );

      allow list: if isApprovedUser() && (
        isAdmin()
        || resource.data.ownerUid == request.auth.uid
        || canSupervisorAccessDisciple(resource.data)
      );

      allow create: if isValidId(scheduleId)
        && isApprovedUser()
        && isValidWorkSchedule(request.resource.data)
        && (request.resource.data.ownerUid == request.auth.uid || isAdmin());

      allow update: if isValidId(scheduleId)
        && isApprovedUser()
        && isValidWorkSchedule(request.resource.data)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.weekStart == resource.data.weekStart
        && (request.resource.data.ownerUid == request.auth.uid || isAdmin());

      allow delete: if isValidId(scheduleId) && isApprovedUser() && (
        isAdmin() || resource.data.ownerUid == request.auth.uid
      );
    }

    // ---------- Báo cáo hằng ngày (dailyReports/{id}) ----------
    match /dailyReports/{id} {
      allow read: if isApprovedUser() && (
        isAdmin()
        || resource.data.uid == request.auth.uid
        || (
          ('companyCode' in resource.data)
          && ('areaCode' in resource.data)
          && canSupervisorAccessDailyReport(resource.data)
        )
      );
      allow create: if isApprovedUser()
        && isValidDailyReport(request.resource.data)
        && (isAdmin() || request.resource.data.uid == request.auth.uid);
      allow update: if isApprovedUser()
        && isValidDailyReport(request.resource.data)
        && (
          isAdmin()
          || (
            resource.data.uid == request.auth.uid
            && request.resource.data.uid == request.auth.uid
          )
        );
      allow delete: if isAdmin() || (isApprovedUser() && resource.data.uid == request.auth.uid);
    }

    // ---------- Mục tiêu Tháng / Năm (periodGoals/{id}) ----------
    match /periodGoals/{id} {
      allow get: if isApprovedUser() && (
        isAdmin()
        || id.matches('^' + request.auth.uid + '_.*')
        || resource.data.uid == request.auth.uid
      );
      allow list: if isApprovedUser() && (
        isAdmin()
        || resource.data.uid == request.auth.uid
      );
      allow create, update: if isApprovedUser() && (
        isAdmin() || request.resource.data.uid == request.auth.uid
      );
      allow delete: if isAdmin() || (isApprovedUser() && resource.data.uid == request.auth.uid);
    }

    // ---------- users/{uid}: hồ sơ tài khoản, Mã cá nhân 6 số, phê duyệt đăng ký & phân quyền 7 cấp ----------
    match /users/{uid} {
      allow get: if isSignedIn() && (
        request.auth.uid == uid
        || isAdmin()
        || (isApprovedUser() && canSupervisorAccessOrg(resource.data))
      );
      allow list: if isAdmin() || (
        isApprovedUser()
        && (isManager() || isSionLeader() || isAreaLeader() || isUniLeader())
        && canSupervisorAccessOrg(resource.data)
      );

      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() > 0
        && request.resource.data.fullName.size() <= 100
        && (!('pinHash' in request.resource.data) || (request.resource.data.pinHash is string && request.resource.data.pinHash.size() >= 16 && request.resource.data.pinHash.size() <= 128))
        && ('approvalStatus' in request.resource.data)
        && request.resource.data.approvalStatus in ['PENDING', 'APPROVED']
        && (
          request.resource.data.approvalStatus == 'PENDING'
          || !isApprovalRequired()
          || isSuperAdmin()
          || isSuperAdminEmail(request.auth.token.email)
          || (isAutoApprovePreAssignedEnabled() && hasOwnRoleClaim())
        )
        && (
          (
            request.resource.data.role == 'MEMBER'
            && (!('managedCompanyCodes' in request.resource.data) || request.resource.data.managedCompanyCodes.size() == 0)
            && (!('managedAreaCodes' in request.resource.data) || request.resource.data.managedAreaCodes.size() == 0)
            && (!('managedUnitCodes' in request.resource.data) || request.resource.data.managedUnitCodes.size() == 0)
          ) || (
            request.resource.data.role in ['ADMIN', 'SUPER_ADMIN', 'MANAGER', 'SION_LEADER', 'AREA_LEADER', 'UNI_LEADER']
            && (
              isSuperAdmin()
              || isSuperAdminEmail(request.auth.token.email)
              || (hasOwnRoleClaim() && request.resource.data.role == ownRoleClaimData().role)
            )
          )
        );

      allow update: if isSignedIn() && (
        isSuperAdmin()
        || isSuperAdminEmail(request.auth.token.email)
        || (
          isAdmin()
          && request.resource.data.role != 'SUPER_ADMIN'
          && resource.data.role != 'SUPER_ADMIN'
          && (!('pinHash' in request.resource.data) || (request.resource.data.pinHash is string && request.resource.data.pinHash.size() >= 16 && request.resource.data.pinHash.size() <= 128))
          && (
            request.resource.data.role == resource.data.role
            || (roleLevel(resource.data.role) <= 5 && roleLevel(request.resource.data.role) <= 5)
            || (
              request.resource.data.diff(resource.data).affectedKeys().hasAny(['approvalStatus'])
              && roleLevel(request.resource.data.role) <= 6
            )
          )
        )
        || (
          isApprovedUser()
          && (isManager() || isSionLeader() || isAreaLeader() || isUniLeader())
          && uid != request.auth.uid
          && canSupervisorAccessOrg(resource.data)
          && canSupervisorAccessOrg(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'role', 'managedCompanyCodes', 'managedAreaCodes', 'managedUnitCodes'
          ])
          && roleLevel(resource.data.role) < actorRoleLevel()
          && roleLevel(request.resource.data.role) < actorRoleLevel()
        )
        || (
          request.auth.uid == uid
          && (!('pinHash' in request.resource.data) || (request.resource.data.pinHash is string && request.resource.data.pinHash.size() >= 16 && request.resource.data.pinHash.size() <= 128))
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'approvalStatus', 'approvedBy', 'approvedAt', 'rejectionReason'
          ])
          && (
            (
              !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'managedCompanyCodes', 'managedAreaCodes', 'managedUnitCodes'])
              && request.resource.data.role == resource.data.role
            )
            || (request.resource.data.role == 'SUPER_ADMIN' && isSuperAdminEmail(request.auth.token.email))
            || (
              hasOwnRoleClaim()
              && request.resource.data.role == ownRoleClaimData().role
              && (!('managedCompanyCodes' in request.resource.data) || !('managedCompanyCodes' in ownRoleClaimData()) || request.resource.data.managedCompanyCodes == ownRoleClaimData().managedCompanyCodes)
              && (!('managedAreaCodes' in request.resource.data) || !('managedAreaCodes' in ownRoleClaimData()) || request.resource.data.managedAreaCodes == ownRoleClaimData().managedAreaCodes)
              && (!('managedUnitCodes' in request.resource.data) || !('managedUnitCodes' in ownRoleClaimData()) || request.resource.data.managedUnitCodes == ownRoleClaimData().managedUnitCodes)
            )
          )
        )
      );

      allow delete: if isSuperAdmin() || isSuperAdminEmail(request.auth.token.email);
    }

    // ---------- Danh mục: công ty, khu vực, ban ngành (mở đọc để hiển thị dropdown đăng ký) ----------
    match /companies/{id} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isApprovedUser()
        && (isManager() || isSionLeader())
        && request.resource.data.code == resource.data.code
        && (
          resource.data.code == get(userDocPath()).data.companyCode
          || ('managedCompanyCodes' in get(userDocPath()).data && resource.data.code in get(userDocPath()).data.managedCompanyCodes)
        )
      );
    }

    match /areas/{id} {
      allow read: if true;
      allow create: if isAdmin() || (
        isApprovedUser()
        && (isManager() || isSionLeader())
        && (
          request.resource.data.companyCode == get(userDocPath()).data.companyCode
          || ('managedCompanyCodes' in get(userDocPath()).data && request.resource.data.companyCode in get(userDocPath()).data.managedCompanyCodes)
        )
      );
      allow update: if isAdmin() || (
        isApprovedUser() && (
          (
            (isManager() || isSionLeader())
            && request.resource.data.companyCode == resource.data.companyCode
            && (
              resource.data.companyCode == get(userDocPath()).data.companyCode
              || ('managedCompanyCodes' in get(userDocPath()).data && resource.data.companyCode in get(userDocPath()).data.managedCompanyCodes)
            )
          ) || (
            isAreaLeader()
            && request.resource.data.companyCode == resource.data.companyCode
            && request.resource.data.code == resource.data.code
            && (
              resource.data.code == get(userDocPath()).data.areaCode
              || ('managedAreaCodes' in get(userDocPath()).data && resource.data.code in get(userDocPath()).data.managedAreaCodes)
            )
          )
        )
      );
      allow delete: if isAdmin() || (
        isApprovedUser()
        && (isManager() || isSionLeader())
        && (
          resource.data.companyCode == get(userDocPath()).data.companyCode
          || ('managedCompanyCodes' in get(userDocPath()).data && resource.data.companyCode in get(userDocPath()).data.managedCompanyCodes)
        )
      );
    }

    match /departments/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------- members/{id}: thành viên & điểm số thi đua ----------
    match /members/{id} {
      allow read: if isApprovedUser();

      allow create: if isSignedIn() && (
        isAdmin()
        || (
          id == ownMemberId()
          && (
            request.resource.data.active == false
            || getAfter(userDocPath()).data.approvalStatus == 'APPROVED'
            || isApprovedUser()
          )
        )
        || (
          isApprovedUser()
          && (isManager() || isSionLeader() || isAreaLeader() || isUniLeader())
          && canSupervisorAccessOrg(request.resource.data)
        )
      );

      allow update: if isApprovedUser() && (
        isAdmin()
        || id == ownMemberId()
        || (
          (isManager() || isSionLeader() || isAreaLeader() || isUniLeader())
          && canSupervisorAccessOrg(resource.data)
          && canSupervisorAccessOrg(request.resource.data)
        )
      );

      allow delete: if isAdmin() || (
        isApprovedUser()
        && (isManager() || isSionLeader() || isAreaLeader() || isUniLeader())
        && canSupervisorAccessOrg(resource.data)
      );
    }

    // ---------- targets/{id}: nhật ký đối tượng chi tiết (legacy) ----------
    match /targets/{id} {
      allow read: if isApprovedUser() && (
        isAdmin() || resource.data.memberId == ownMemberId()
      );
      allow create: if isApprovedUser() && (
        isAdmin() || request.resource.data.memberId == ownMemberId()
      );
      allow update: if isApprovedUser() && (
        isAdmin() || (
          resource.data.memberId == ownMemberId()
          && request.resource.data.memberId == ownMemberId()
        )
      );
      allow delete: if isAdmin() || (isApprovedUser() && resource.data.memberId == ownMemberId());
    }

    // ---------- huongKhi/{id}: bài chia sẻ hương khí & lời chứng ----------
    match /huongKhi/{id} {
      allow read: if isApprovedUser();

      allow create: if isApprovedUser()
        && (isAdmin() || request.resource.data.authorId == ownMemberId())
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 300
        && request.resource.data.content is string;

      allow update: if isApprovedUser() && (
        isAdmin()
        || resource.data.authorId == ownMemberId()
        || request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['reactions', 'likesCount', 'userReaction', 'comments', 'userReactions'])
      );

      allow delete: if isAdmin() || (isApprovedUser() && resource.data.authorId == ownMemberId());
    }
  }
}
