{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile, organizational placement, and 7-tier access role",
      "type": "object",
      "properties": {
        "fullName": { "type": "string", "maxLength": 100 },
        "username": { "type": "string", "maxLength": 50 },
        "email": { "type": "string", "maxLength": 150 },
        "role": { "type": "string", "enum": ["SUPER_ADMIN", "ADMIN", "MANAGER", "SION_LEADER", "AREA_LEADER", "UNI_LEADER", "MEMBER"] },
        "memberId": { "type": "string", "maxLength": 128 },
        "companyCode": { "type": "string", "maxLength": 30 },
        "areaCode": { "type": "string", "maxLength": 30 },
        "unitCode": { "type": "string", "maxLength": 50 },
        "departmentCode": { "type": "string", "maxLength": 50 },
        "managedCompanyCodes": { "type": "array" },
        "managedAreaCodes": { "type": "array" },
        "managedUnitCodes": { "type": "array" },
        "avatarUrl": { "type": "string", "maxLength": 200000 },
        "coverUrl": { "type": "string", "maxLength": 200000 },
        "bio": { "type": "string", "maxLength": 500 },
        "emailVerified": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["fullName", "email", "role"]
    },
    "Disciple": {
      "title": "Disciple",
      "description": "Disciple tracking notebook entry (Trang thông tin MĐ)",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string", "maxLength": 128 },
        "ownerMemberId": { "type": "string", "maxLength": 128 },
        "ownerName": { "type": "string", "maxLength": 100 },
        "companyCode": { "type": "string", "maxLength": 30 },
        "areaCode": { "type": "string", "maxLength": 30 },
        "ownerUnitCode": { "type": "string", "maxLength": 50 },
        "nickname": { "type": "string", "maxLength": 60 },
        "ageMode": { "type": "string", "enum": ["RANGE", "EXACT"] },
        "ageRange": { "type": "string", "enum": ["<18", "18-22", "23-30", "31-45", ">45"] },
        "exactAge": { "type": "number" },
        "job": { "type": "string", "maxLength": 100 },
        "traits": { "type": "string", "maxLength": 400 },
        "progress": { "type": "array" },
        "isStopped": { "type": "boolean" },
        "statusNote": { "type": "string", "maxLength": 600 },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 },
        "updatedBy": { "type": "string", "maxLength": 100 }
      },
      "required": ["ownerUid", "companyCode", "areaCode", "nickname", "ageMode", "ageRange", "progress", "isStopped", "createdAt", "updatedAt"]
    },
    "DailyReport": {
      "title": "DailyReport",
      "description": "Daily abbreviated report metrics (KN, Thăm, GM, ĐT, HH, KT, WS New)",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "memberId": { "type": "string", "maxLength": 128 },
        "date": { "type": "string", "maxLength": 15 },
        "month": { "type": "string", "maxLength": 10 },
        "year": { "type": "string", "maxLength": 6 },
        "goals": { "type": "object" },
        "results": { "type": "object" },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["uid", "date", "month", "year", "goals", "results"]
    },
    "PeriodGoal": {
      "title": "PeriodGoal",
      "description": "Personal month or year target goals",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "periodType": { "type": "string", "enum": ["MONTH", "YEAR"] },
        "periodKey": { "type": "string", "maxLength": 15 },
        "goals": { "type": "object" },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["uid", "periodType", "periodKey", "goals"]
    },
    "FestivalEvent": {
      "title": "FestivalEvent",
      "description": "Festival competition campaign with dates, rules, weights, and approved participants",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 150 },
        "description": { "type": "string", "maxLength": 1000 },
        "rulesText": { "type": "string", "maxLength": 3000 },
        "startDate": { "type": "string", "maxLength": 15 },
        "endDate": { "type": "string", "maxLength": 15 },
        "isActive": { "type": "boolean" },
        "isPinned": { "type": "boolean" },
        "restrictParticipants": { "type": "boolean" },
        "participantIds": { "type": "array" },
        "weights": { "type": "object" }
      },
      "required": ["title", "startDate", "endDate", "isActive"]
    },
    "SystemConfig": {
      "title": "SystemConfig",
      "description": "Shared system configuration docs (roles, banner, scoring, appearance)",
      "type": "object",
      "properties": {
        "weights": { "type": "object" },
        "fontKey": { "type": "string", "maxLength": 40 },
        "fontScale": { "type": "string", "enum": ["SM", "MD", "LG"] },
        "widgetOrder": { "type": "array" },
        "hiddenWidgets": { "type": "array" },
        "homeWidgets": { "type": "object" },
        "actionStripLabel": { "type": "string", "maxLength": 150 },
        "visibility": { "type": "object" },
        "updatedAt": { "type": "string", "maxLength": 50 },
        "updatedBy": { "type": "string", "maxLength": 100 }
      }
    },
    "EduWeeklyTopic": {
      "title": "EduWeeklyTopic",
      "description": "Weekly topic & CMS lesson curriculum for LMS tracks (TĐ-I, TĐ-II, NGV)",
      "type": "object",
      "properties": {
        "weekNumber": { "type": "number" },
        "year": { "type": "number" },
        "weekLabel": { "type": "string", "maxLength": 60 },
        "startDate": { "type": "string", "maxLength": 15 },
        "endDate": { "type": "string", "maxLength": 15 },
        "track": { "type": "string", "enum": ["TD_I", "TD_II", "NGV"] },
        "companyCode": { "type": "string", "maxLength": 30 },
        "areaCode": { "type": "string", "maxLength": 40 },
        "topicTitle": { "type": "string", "maxLength": 200 },
        "summary": { "type": "string", "maxLength": 1000 },
        "learningObjectives": { "type": "string", "maxLength": 1000 },
        "curriculumContent": { "type": "string", "maxLength": 20000 },
        "referenceLinks": { "type": "string", "maxLength": 1000 },
        "createdBy": { "type": "string", "maxLength": 100 },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["weekNumber", "year", "weekLabel", "startDate", "endDate", "track", "companyCode", "areaCode", "topicTitle", "curriculumContent", "createdBy", "createdAt", "updatedAt"]
    },
    "EduTopicAssignment": {
      "title": "EduTopicAssignment",
      "description": "Assignment linking Tên KV & Tên TĐ to a weekly LMS topic",
      "type": "object",
      "properties": {
        "topicId": { "type": "string", "maxLength": 128 },
        "track": { "type": "string", "enum": ["TD_I", "TD_II", "NGV"] },
        "weekLabel": { "type": "string", "maxLength": 60 },
        "topicTitle": { "type": "string", "maxLength": 200 },
        "companyCode": { "type": "string", "maxLength": 30 },
        "areaCode": { "type": "string", "maxLength": 40 },
        "memberId": { "type": "string", "maxLength": 128 },
        "studentName": { "type": "string", "maxLength": 120 },
        "assignedByUid": { "type": "string", "maxLength": 128 },
        "assignedByName": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "enum": ["REGISTERED", "IN_PROGRESS", "COMPLETED"] },
        "note": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["topicId", "track", "weekLabel", "topicTitle", "companyCode", "areaCode", "studentName", "assignedByUid", "assignedByName", "status", "createdAt", "updatedAt"]
    },
    "EduCmsProfile": {
      "title": "EduCmsProfile",
      "description": "CMS learner progression (TĐ Mới -> TĐ-I -> TĐ-II) and NGV mentor roster",
      "type": "object",
      "properties": {
        "fullName": { "type": "string", "maxLength": 120 },
        "companyCode": { "type": "string", "maxLength": 30 },
        "areaCode": { "type": "string", "maxLength": 40 },
        "stage": { "type": "string", "enum": ["TD_MOI", "TD_I", "TD_II", "NGV"] },
        "ngvName": { "type": "string", "maxLength": 120 },
        "specialty": { "type": "string", "maxLength": 200 },
        "currentTopicId": { "type": "string", "maxLength": 128 },
        "currentTopicTitle": { "type": "string", "maxLength": 200 },
        "note": { "type": "string", "maxLength": 600 },
        "ownerUid": { "type": "string", "maxLength": 128 },
        "updatedBy": { "type": "string", "maxLength": 100 },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["fullName", "companyCode", "areaCode", "stage", "ngvName", "ownerUid", "updatedBy", "createdAt", "updatedAt"]
    },
    "WorkSchedule": {
      "title": "WorkSchedule",
      "description": "Weekly personal activity schedule (CN-T7, 3 daily sessions + toggleable WS sessions)",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string", "maxLength": 128 },
        "ownerMemberId": { "type": "string", "maxLength": 128 },
        "ownerName": { "type": "string", "maxLength": 100 },
        "companyCode": { "type": "string", "maxLength": 30 },
        "areaCode": { "type": "string", "maxLength": 30 },
        "ownerUnitCode": { "type": "string", "maxLength": 50 },
        "weekStart": { "type": "string", "maxLength": 15 },
        "weekEnd": { "type": "string", "maxLength": 15 },
        "sessions": { "type": "object" },
        "wsActiveDays": { "type": "array" },
        "ws": { "type": "object" },
        "noteLegend": { "type": "string", "maxLength": 600 },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["ownerUid", "ownerName", "companyCode", "areaCode", "weekStart", "weekEnd", "sessions", "wsActiveDays", "ws", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User accounts, roles, and managed scopes"
    },
    "/system_config/{id}": {
      "schema": "SystemConfig",
      "description": "System-wide configuration (roles, banner, scoring, appearance)"
    },
    "/disciples/{discipleId}": {
      "schema": "Disciple",
      "description": "Disciple tracking entries scoped by owner, area leader, manager, and admin"
    },
    "/dailyReports/{reportId}": {
      "schema": "DailyReport",
      "description": "Daily competition report records"
    },
    "/periodGoals/{goalId}": {
      "schema": "PeriodGoal",
      "description": "Personal month and year goal settings"
    },
    "/events/{eventId}": {
      "schema": "FestivalEvent",
      "description": "Festival event campaigns"
    },
    "/edu_topics/{topicId}": {
      "schema": "EduWeeklyTopic",
      "description": "Weekly LMS topics and CMS curriculum content"
    },
    "/edu_assignments/{assignmentId}": {
      "schema": "EduTopicAssignment",
      "description": "Assignments of KV and Tên TĐ to weekly LMS topics"
    },
    "/edu_cms_profiles/{profileId}": {
      "schema": "EduCmsProfile",
      "description": "CMS learner progression (TĐ Mới -> TĐ-II) and NGV mentor roster"
    },
    "/work_schedules/{scheduleId}": {
      "schema": "WorkSchedule",
      "description": "Weekly activity schedules (CN -> T7) scoped by owner and RBAC supervisors"
    }
  }
}
